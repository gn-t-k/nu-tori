{
  "extends": "@tsconfig/strictest/tsconfig.json",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "noEmit": true,
    // vite.config.ts を Vite が Node でそのまま読めるよう、拡張子つきで import する
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types", "node"]
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"]
}
