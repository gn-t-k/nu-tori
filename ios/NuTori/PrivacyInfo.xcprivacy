<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
アプリのプライバシーマニフェスト。集めるデータの種類は、App Store Connect の App Privacy の回答とそろえる。
回答の表の置き場と、集めるもの・送り先・使い道を変えるときの直し方は docs/agents/privacy.md。
Sentry と PostHog の SDK のマニフェストは、それぞれのデータを「ユーザーに結びつかない」と宣言するが、
nu-tori はアカウント ID を付けて送るので、ここでは「結びつく」と宣言する。
UserDefaults は、サインインの端末の記憶（UserDefaultsSignInDeviceStore）と締め出しの記憶（UserDefaultsAppLockoutStore）に使う。
-->
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyCollectedDataTypes</key>
