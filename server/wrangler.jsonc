{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 上の階層は開発用。本番は env.production で、つなぎは環境ごとに書き直す
  "name": "nu-tori-development",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  // Sentry の SDK が AsyncLocalStorage を使う
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "exports": {
    "AccountDurableObject": { "type": "durable-object", "storage": "sqlite" },
  },
  // 場所のヒントはここに書けないので、src/durable-object/get-account-durable-object.ts で渡す
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNT", "class_name": "AccountDurableObject" }],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nu-tori-development",
      "migrations_dir": "d1-migrations",
    },
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "nu-tori-development-photos" }],
  "ai": { "binding": "AI" },
  // routes は環境に受け継がれるので、本番にも書く
  "routes": [{ "pattern": "api-dev.nu-tori.app", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // observability は環境に受け継がれないので、本番にも書く
  "observability": { "enabled": true },
  // Sign in with Apple の ID トークンの aud。アプリの Bundle ID（ios/NuTori.xcodeproj の PRODUCT_BUNDLE_IDENTIFIER）
  "vars": { "APPLE_BUNDLE_ID": "app.nu-tori", "SENTRY_ENVIRONMENT": "development" },
  // namespace_id は Cloudflare のアカウントの中で一意にし、同じ値の Worker どうしで数を分け合う
  "ratelimits": [
    {
      "name": "ACCOUNT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "APPLE_TEAM_ID",
      "APPLE_KEY_ID",
      "APPLE_PRIVATE_KEY",
      "APPLE_REFRESH_TOKEN_KEYS",
      "SENTRY_DSN",
    ],
  },
  "env": {
    "production": {
      "name": "nu-tori-production",
      "exports": {
        "AccountDurableObject": { "type": "durable-object", "storage": "sqlite" },
      },
      "durable_objects": {
        "bindings": [{ "name": "ACCOUNT", "class_name": "AccountDurableObject" }],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nu-tori-production",
          "migrations_dir": "d1-migrations",
        },
      ],
      "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "nu-tori-production-photos" }],
      "ai": { "binding": "AI" },
      "routes": [{ "pattern": "api.nu-tori.app", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      "vars": { "APPLE_BUNDLE_ID": "app.nu-tori", "SENTRY_ENVIRONMENT": "production" },
      "ratelimits": [
        {
          "name": "ACCOUNT_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 120, "period": 60 },
        },
      ],
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "APPLE_TEAM_ID",
          "APPLE_KEY_ID",
          "APPLE_PRIVATE_KEY",
          "APPLE_REFRESH_TOKEN_KEYS",
          "SENTRY_DSN",
          // PostHog には本番だけが送る
          "POSTHOG_PROJECT_ID",
          "POSTHOG_PERSONAL_API_KEY",
        ],
      },
    },
  },
}
