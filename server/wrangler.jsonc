{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 上の階層は開発用。本番は env.production で、つなぎは環境ごとに書き直す
  "name": "nu-tori-development",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  // Sentry の SDK が AsyncLocalStorage を使う
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "exports": {
    "AccountDurableObject": { "type": "durable-object", "storage": "sqlite" },
  },
  // 場所のヒントはここに書けないので、src/durable-object/get-account-durable-object.ts で渡す
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNT", "class_name": "AccountDurableObject" }],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nu-tori-development",
      "migrations_dir": "d1-migrations",
    },
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "nu-tori-development-photos" }],
  // routes は環境に受け継がれるので、本番にも書く
  "routes": [{ "pattern": "api-dev.nu-tori.app", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // 本番にも受け継がれる
  "observability": { "enabled": true },
  // Sign in with Apple の ID トークンの aud。アプリの Bundle ID（ios/NuTori.xcodeproj の PRODUCT_BUNDLE_IDENTIFIER）
  // BILLING_STARTED_ON は課金を入れた日（YYYY-MM-DD）。課金を入れる前からのアカウントの無料体験はこの日から数える（#647）。
  // 開発用は、主な流れを確かめるジョブ（e2e/run-main-flow.ts）が無料体験の終わったアカウントを作れるよう、30日より前の日にする
  "vars": {
    "APPLE_BUNDLE_ID": "app.nu-tori",
    "SENTRY_ENVIRONMENT": "development",
    "BILLING_STARTED_ON": "2026-09-01",
  },
  // namespace_id は Cloudflare のアカウントの中で一意にし、同じ値の Worker どうしで数を分け合う
  "ratelimits": [
    {
      "name": "ACCOUNT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "APPLE_TEAM_ID",
      "APPLE_KEY_ID",
      "APPLE_PRIVATE_KEY",
      "APPLE_REFRESH_TOKEN_KEYS",
      // 無料体験を使った Apple ID のハッシュの鍵。「版:base64 の鍵」をカンマで並べる
      "APPLE_SUB_HASH_KEYS",
      "SENTRY_DSN",
      // 推定の提供元（Anthropic）の API キー。環境ごとのワークスペース（nu-tori-development）のもの
      "ANTHROPIC_API_KEY",
    ],
  },
  "env": {
    "production": {
      "name": "nu-tori-production",
      "exports": {
        "AccountDurableObject": { "type": "durable-object", "storage": "sqlite" },
      },
      "durable_objects": {
        "bindings": [{ "name": "ACCOUNT", "class_name": "AccountDurableObject" }],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nu-tori-production",
          "migrations_dir": "d1-migrations",
        },
      ],
      "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "nu-tori-production-photos" }],
      "routes": [{ "pattern": "api.nu-tori.app", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      // PostHog のプロジェクトのトークン（公開してよい phc_ の値）。PostHog には本番だけが送る
      // MINIMUM_APP_BUILD は受け付けるいちばん古いアプリのビルド番号。本番にだけ置き、開発用は判定しない。
      // 上げる手順は docs/agents/ios-release.md
      // BILLING_STARTED_ON は、課金の入ったアプリの版を App Store に出す日に合わせる（#685）。それまでは遠い先の日にしておく
      "vars": {
        "APPLE_BUNDLE_ID": "app.nu-tori",
        "SENTRY_ENVIRONMENT": "production",
        "BILLING_STARTED_ON": "2099-12-31",
        "POSTHOG_PROJECT_TOKEN": "phc_yYuKJmqxpHM77An2fa7NYoL8SK2RkbbEXgpVUQQ2fjze",
        "MINIMUM_APP_BUILD": 53,
      },
      "ratelimits": [
        {
          "name": "ACCOUNT_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 120, "period": 60 },
        },
      ],
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "APPLE_TEAM_ID",
          "APPLE_KEY_ID",
          "APPLE_PRIVATE_KEY",
          "APPLE_REFRESH_TOKEN_KEYS",
          "APPLE_SUB_HASH_KEYS",
          "SENTRY_DSN",
          // 推定の提供元（Anthropic）の API キー。本番のワークスペース（nu-tori-production）のもの
          "ANTHROPIC_API_KEY",
          // PostHog には本番だけが送る
          "POSTHOG_PROJECT_ID",
          "POSTHOG_PERSONAL_API_KEY",
        ],
      },
    },
  },
}
