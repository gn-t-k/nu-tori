{
  "openapi": "3.1.0",
  "info": {
    "title": "nu-tori",
    "version": "1"
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "RecordKindName": {
        "type": "string",
        "enum": [
          "account_settings",
          "dish",
          "ingredient",
          "meal",
          "meal_estimation_status",
          "weight_record"
        ],
        "description": "サーバーが同期で扱う記録の種類の名前。応答の kind を解くのには使わない（知らない種類を読み飛ばすため、応答では文字列で持つ）"
      },
      "SyncWriteResult": {
        "type": "object",
        "properties": {
          "writeId": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "description": "値が増えても古い版のアプリが読めるよう文字列で持つ。知らない値は端末が知らない結果として扱う",
            "example": "applied"
          },
          "rejectionReason": {
            "type": "string",
            "description": "result が rejected のときだけ付く。値が増えても読めるよう文字列で持つ"
          },
          "current": {
            "$ref": "#/components/schemas/SyncWriteCurrent"
          }
        },
        "required": [
          "writeId",
          "result"
        ]
      },
      "SyncWriteCurrent": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "value（値）、deleted（削除の印）、absent（記録も削除の印も無い）のどれか。値が増えても古い版のアプリが読めるよう文字列で持つ。知らない値は端末が何も当てない",
            "example": "value"
          },
          "change": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "example": "weight_record"
              },
              "recordId": {
                "type": "string"
              },
              "record": {
                "type": "object",
                "additionalProperties": {}
              }
            },
            "required": [
              "kind",
              "recordId",
              "record"
            ],
            "description": "status が value か deleted のときだけ付く"
          }
        },
        "required": [
          "status"
        ],
        "description": "result が rejected のときだけ付く。その記録のサーバーの今の値で、要求の書き込みを全部当て終えた時点のもの。同じ書き込みの ID が再び届いたときも、最初の結果に、当て終えた時点の値を添える"
      },
      "SyncWrite": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/UpdateAccountSettingsWrite"
          },
          {
            "$ref": "#/components/schemas/CreateMealWrite"
          },
          {
            "$ref": "#/components/schemas/DeleteMealWrite"
          },
          {
            "$ref": "#/components/schemas/CreateWeightRecordWrite"
          },
          {
            "$ref": "#/components/schemas/UpdateWeightRecordWrite"
          },
          {
            "$ref": "#/components/schemas/SourceDeletedWeightRecordWrite"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "update_account_settings": "#/components/schemas/UpdateAccountSettingsWrite",
            "create_meal": "#/components/schemas/CreateMealWrite",
            "delete_meal": "#/components/schemas/DeleteMealWrite",
            "create_weight_record": "#/components/schemas/CreateWeightRecordWrite",
            "update_weight_record": "#/components/schemas/UpdateWeightRecordWrite",
            "source_deleted_weight_record": "#/components/schemas/SourceDeletedWeightRecordWrite"
          }
        },
        "description": "アカウントの設定は、記録が無くても直す書き込みで送り、サーバーが無ければ作る"
      },
      "UpdateAccountSettingsWrite": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "冪等の鍵"
          },
          "type": {
            "type": "string",
            "enum": [
              "update_account_settings"
            ]
          },
          "accountSettings": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "端末で振ったアカウントの設定の ID。アカウント ID から名前空間を分けた UUID v5 で出す。サーバーは ID では探さず、アカウントに1件の記録として持つ"
              },
              "sendsUsageData": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "sendsUsageData"
            ]
          }
        },
        "required": [
          "id",
          "type",
          "accountSettings"
        ]
      },
      "CreateMealWrite": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "冪等の鍵"
          },
          "type": {
            "type": "string",
            "enum": [
              "create_meal"
            ]
          },
          "meal": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "eatenAt": {
                "type": "integer",
                "minimum": -8640000000000000,
                "maximum": 8640000000000000,
                "description": "UNIX 時刻のミリ秒（UTC）"
              },
              "eatenAtUtcOffsetSeconds": {
                "type": "integer",
                "description": "撮った時刻の UTC との時差の秒",
                "example": 32400
              },
              "sentAt": {
                "type": "integer",
                "minimum": -8640000000000000,
                "maximum": 8640000000000000,
                "description": "UNIX 時刻のミリ秒（UTC）"
              },
              "sentTimeZone": {
                "type": "string",
                "example": "Asia/Tokyo"
              },
              "entryMethod": {
                "type": "string",
                "description": "入口。撮った（captured）か、撮っておいた写真を選んだ（picked）か",
                "example": "captured"
              },
              "photos": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id"
                  ]
                },
                "description": "並びが写真の並び順"
              }
            },
            "required": [
              "id",
              "eatenAt",
              "eatenAtUtcOffsetSeconds",
              "sentAt",
              "sentTimeZone",
              "entryMethod",
              "photos"
            ]
          }
        },
        "required": [
          "id",
          "type",
          "meal"
        ]
      },
      "DeleteMealWrite": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "冪等の鍵"
          },
          "type": {
            "type": "string",
            "enum": [
              "delete_meal"
            ]
          },
          "mealId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "type",
          "mealId"
        ]
      },
      "CreateWeightRecordWrite": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "冪等の鍵"
          },
          "type": {
            "type": "string",
            "enum": [
              "create_weight_record"
            ]
          },
          "weightRecord": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "weightKg": {
                "type": "number"
              },
              "measuredAt": {
                "type": "integer",
                "minimum": -8640000000000000,
                "maximum": 8640000000000000,
                "description": "UNIX 時刻のミリ秒（UTC）"
              },
              "timeZone": {
                "type": "string",
                "example": "Asia/Tokyo"
              },
              "imported": {
                "type": "object",
                "properties": {
                  "sourceAppName": {
                    "type": "string"
                  },
                  "sourceBundleId": {
                    "type": "string"
                  },
                  "healthkitSampleUuid": {
                    "type": "string",
                    "minLength": 1
                  },
                  "bodyFat": {
                    "type": "object",
                    "properties": {
                      "percentage": {
                        "type": "number"
                      },
                      "healthkitSampleUuid": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "percentage",
                      "healthkitSampleUuid"
                    ]
                  }
                },
                "required": [
                  "sourceAppName",
                  "sourceBundleId",
                  "healthkitSampleUuid"
                ]
              }
            },
            "required": [
              "id",
              "weightKg",
              "measuredAt",
              "timeZone"
            ]
          }
        },
        "required": [
          "id",
          "type",
          "weightRecord"
        ]
      },
      "UpdateWeightRecordWrite": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "冪等の鍵"
          },
          "type": {
            "type": "string",
            "enum": [
              "update_weight_record"
            ]
          },
          "weightRecord": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "weightKg": {
                "type": "number"
              },
              "measuredAt": {
                "type": "integer",
                "minimum": -8640000000000000,
                "maximum": 8640000000000000,
                "description": "UNIX 時刻のミリ秒（UTC）"
              },
              "timeZone": {
                "type": "string",
                "example": "Asia/Tokyo"
              },
              "version": {
                "type": "integer"
              }
            },
            "required": [
              "id",
              "weightKg",
              "measuredAt",
              "timeZone",
              "version"
            ]
          }
        },
        "required": [
          "id",
          "type",
          "weightRecord"
        ]
      },
      "SourceDeletedWeightRecordWrite": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "冪等の鍵"
          },
          "type": {
            "type": "string",
            "enum": [
              "source_deleted_weight_record"
            ]
          },
          "weightRecordId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "type",
          "weightRecordId"
        ]
      },
      "SyncChange": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer"
          },
          "kind": {
            "type": "string",
            "description": "知らない種類は読み飛ばす。種類が増えても古い版のアプリの同期が止まらないよう、文字列で持つ",
            "example": "weight_record"
          },
          "recordId": {
            "type": "string"
          },
          "record": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "sequence",
          "kind",
          "recordId",
          "record"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/sessions": {
      "post": {
        "operationId": "createSession",
        "summary": "Sign in with Apple でサインインし、セッションを始める",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "idToken": {
                    "type": "string"
                  },
                  "nonce": {
                    "type": "string",
                    "minLength": 1
                  },
                  "authorizationCode": {
                    "type": "string"
                  },
                  "timeZone": {
                    "type": "string",
                    "description": "端末の IANA のタイムゾーン名。最初のサインインで、使い始めた日をこの土地の日付にする",
                    "example": "Asia/Tokyo"
                  }
                },
                "required": [
                  "idToken",
                  "nonce",
                  "authorizationCode"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "サインインした。以後の要求では sessionToken を Bearer で送る",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sessionToken": {
                      "type": "string"
                    },
                    "accountId": {
                      "type": "string",
                      "description": "nu-tori のアカウント ID"
                    }
                  },
                  "required": [
                    "sessionToken",
                    "accountId"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "ID トークンか認可コードを受け付けなかった"
          }
        }
      }
    },
    "/v1/account": {
      "delete": {
        "operationId": "deleteAccount",
        "summary": "アカウントと記録をすべて消す",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "204": {
            "description": "消した"
          },
          "401": {
            "description": "セッションが無いか、切れている"
          },
          "429": {
            "description": "回数の歯止めにかかった"
          }
        }
      }
    },
    "/v1/sync/writes": {
      "post": {
        "operationId": "pushSyncWrites",
        "summary": "端末の送り待ちをまとめて送る",
        "security": [
          {
            "session": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "clientState": {
                    "type": "object",
                    "properties": {
                      "deviceId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "timeZone": {
                        "type": "string",
                        "minLength": 1,
                        "description": "読めない名前でも、届いたまま控える",
                        "example": "Asia/Tokyo"
                      },
                      "appVersion": {
                        "type": "string",
                        "minLength": 1
                      },
                      "osVersion": {
                        "type": "string",
                        "minLength": 1
                      },
                      "pendingWriteCount": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "oldestPendingWriteAgeSeconds": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "pendingPhotoCount": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "deviceId",
                      "timeZone",
                      "appVersion",
                      "osVersion",
                      "pendingWriteCount",
                      "pendingPhotoCount"
                    ]
                  },
                  "writes": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/SyncWrite"
                    },
                    "maxItems": 500
                  },
                  "isFinalBatch": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "clientState",
                  "writes",
                  "isFinalBatch"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "書き込みごとの結果。要求の書き込みと同じ順",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SyncWriteResult"
                      }
                    }
                  },
                  "required": [
                    "results"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "要求の形が違うか、書き込みが 500 件を超えている。何も当てていない"
          },
          "401": {
            "description": "セッションが無いか、切れている"
          },
          "429": {
            "description": "回数の歯止めにかかった"
          }
        }
      }
    },
    "/v1/sync/changes": {
      "get": {
        "operationId": "pullSyncChanges",
        "summary": "前回の続きからの変更を取りに行く",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "deviceId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "読めない名前でも、届いたまま控える",
              "example": "Asia/Tokyo"
            },
            "required": true,
            "description": "読めない名前でも、届いたまま控える",
            "name": "timeZone",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "appVersion",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "osVersion",
            "in": "query"
          },
          {
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "required": true,
            "name": "pendingWriteCount",
            "in": "query"
          },
          {
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "required": false,
            "name": "oldestPendingWriteAgeSeconds",
            "in": "query"
          },
          {
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "required": true,
            "name": "pendingPhotoCount",
            "in": "query"
          },
          {
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "required": true,
            "name": "afterSequence",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "変更を、記録ごとにまとめて古い順に最大 500 件",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "changes": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SyncChange"
                      }
                    },
                    "hasMore": {
                      "type": "boolean"
                    },
                    "nextAfterSequence": {
                      "type": "integer"
                    },
                    "startedOn": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "YYYY-MM-DD。まだ決まっていないとき null。記録の通し番号によらず毎回載る"
                    }
                  },
                  "required": [
                    "changes",
                    "hasMore",
                    "nextAfterSequence",
                    "startedOn"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "要求の形が違う"
          },
          "401": {
            "description": "セッションが無いか、切れている"
          },
          "429": {
            "description": "回数の歯止めにかかった"
          }
        }
      }
    },
    "/v1/meal-photos/{photoId}": {
      "put": {
        "operationId": "putMealPhoto",
        "summary": "食事の写真の縮小版を送る",
        "description": "食事の書き込みとは別に送る。食事より先に届いてもよい。同じ写真が再び届いたときと、消した食事の写真が届いたときも、受け取った形で応える",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "端末が振った写真の ID"
            },
            "required": true,
            "description": "端末が振った写真の ID",
            "name": "photoId",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "image/jpeg": {
              "schema": {
                "type": "string",
                "format": "binary",
                "description": "EXIF の無い JPEG"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "受け取った"
          },
          "400": {
            "description": "経路の形が違う"
          },
          "401": {
            "description": "セッションが無いか、切れている"
          },
          "413": {
            "description": "3 MiB を超えている"
          },
          "415": {
            "description": "JPEG でない"
          },
          "429": {
            "description": "回数の歯止めにかかった"
          },
          "500": {
            "description": "受け取れなかった。送り直す"
          }
        }
      },
      "get": {
        "operationId": "getMealPhoto",
        "summary": "食事の写真の縮小版を取りに行く",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "端末が振った写真の ID"
            },
            "required": true,
            "description": "端末が振った写真の ID",
            "name": "photoId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "受け取っていて、消していない写真",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "セッションが無いか、切れている"
          },
          "404": {
            "description": "まだ受け取っていないか、消した"
          },
          "429": {
            "description": "回数の歯止めにかかった"
          }
        }
      }
    }
  },
  "webhooks": {}
}
