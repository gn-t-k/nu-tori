{
  "openapi": "3.1.0",
  "info": {
    "title": "nu-tori",
    "version": "1"
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/v1/sessions": {
      "post": {
        "operationId": "createSession",
        "summary": "Sign in with Apple でサインインし、セッションを始める",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "idToken": {
                    "type": "string"
                  },
                  "nonce": {
                    "type": "string",
                    "minLength": 1
                  },
                  "authorizationCode": {
                    "type": "string"
                  },
                  "timeZone": {
                    "type": "string",
                    "description": "端末の IANA のタイムゾーン名。最初のサインインで、使い始めた日をこの土地の日付にする",
                    "example": "Asia/Tokyo"
                  }
                },
                "required": [
                  "idToken",
                  "nonce",
                  "authorizationCode"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "サインインした。以後の要求では sessionToken を Bearer で送る",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sessionToken": {
                      "type": "string"
                    },
                    "accountId": {
                      "type": "string",
                      "description": "nu-tori のアカウント ID"
                    }
                  },
                  "required": [
                    "sessionToken",
                    "accountId"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "ID トークンか認可コードを受け付けなかった"
          }
        }
      }
    },
    "/v1/account": {
      "delete": {
        "operationId": "deleteAccount",
        "summary": "アカウントと記録をすべて消す",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "204": {
            "description": "消した"
          },
          "401": {
            "description": "セッションが無いか、切れている"
          },
          "429": {
            "description": "回数の歯止めにかかった"
          }
        }
      }
    }
  },
  "webhooks": {}
}
