#!/usr/bin/env node
// PR の差分のパスから、エージェントが merge してよい振る舞いを変えない変更（フェーズ1・フェーズ2）かを決める（#1000、#1001）
// 実装役が自分で決めないよう、当たるかはここだけで決める。merge の条件は docs/agents/review.md の「判断なしに通す変更」
// 拡張子の無いファイルは Node が CommonJS として読むので、import と top-level await を使わない
"use strict";

const { execFileSync, spawnSync } = require("node:child_process");
const { readFileSync } = require("node:fs");
const { join } = require("node:path");

const root = join(__dirname, "..");

const main = () => {
  const args = process.argv.slice(2);
  if (args.length > 1 || (args[0]?.startsWith("-") && !["--stdin", "--list"].includes(args[0]))) {
    console.error("使い方: scripts/merge-tier [<マージ先のブランチ>]");
    console.error("       scripts/merge-tier --stdin < <git diff --name-status --no-renames の出力>");
    console.error("       scripts/merge-tier --list");
    console.error("  引数なし  origin/main から分かれたあとの、このブランチのコミットの差分で決める。1行目が フェーズ1・フェーズ2・待つ・調べもの のどれか");
    console.error("  --list    フェーズ1・フェーズ2に入れないパスを、ゲートごとに PR の本文に貼れる形で出す");
    return 2;
  }
  if (args[0] === "--list") {
    for (const { name, paths } of GATES) console.log(`- ${name}: ${formatPaths(paths)}`);
    console.log(`- ${LLM_REQUESTS.name}（フェーズ2だけ）: ${formatPaths(LLM_REQUESTS.paths)}`);
    return 0;
  }
  if (args[0] === "--stdin") return report(parseNameStatus(readFileSync(0, "utf8")));
  // 移したファイルは、移す前のパスでもゲートに当たるかを見るので、消したと足したの2つで出す
  const diff = execFileSync("git", ["diff", "--name-status", "--no-renames", `origin/${args[0] ?? "main"}...HEAD`], { encoding: "utf8" });
  return report(parseNameStatus(diff));
};

const parseNameStatus = (text) =>
  text
    .split("\n")
    .filter((line) => line.trim() !== "")
    .map((line) => {
      const [status, path] = line.split("\t");
      return { status: status[0], path };
    });

const report = (changes) => {
  const agentDocuments = pickAgentDocuments(changes.map(({ path }) => path));
  const classified = changes.map((change) => ({ ...change, ...classify(change, agentDocuments) }));
  const verdict = verdictOf(classified);
  console.log(verdict);
  if (verdict === TIER.research) {
    console.log("  フェーズ1の条件ではなく、docs/agents/issue-tracker.md の「調べもののチケットを終える」のとおり、CI が通ったら merge する");
  }
  if (verdict === TIER.phase2) {
    console.log("  フェーズ1の条件に加えて、docs/agents/review.md の「フェーズ2」の条件（振る舞いの変化が無いと好みのレビューが返した、確かめが通った）をそろえて merge する");
  }
  if (classified.length === 0) console.log("  差分が無い");
  for (const { status, path, reason } of classified) console.log(`  ${status}\t${path}\t${reason}`);
  return 0;
};

// フェーズ1にもフェーズ2にも入れないもの。ゲートを弱める変更や、用語・見た目・覆しにくい決定そのものは、開発者が merge を言う。
// 末尾が / のものはフォルダの下の全部、ほかはそのファイルだけに当たる
const GATES = [
  {
    name: "検査を決めるもの",
    paths: [
      "scripts/check",
      "scripts/check.test.js",
      "scripts/agent-docs-duplicates",
      "scripts/agent-docs-duplicates.test.js",
      "scripts/workflow-pipefail",
      "scripts/workflow-pipefail.test.js",
      "scripts/check-app-version",
      "scripts/check-app-version.test.js",
      ".github/actionlint.yaml",
      ".github/workflows/check.yml",
      ".github/workflows/dependency-pr.yml",
      // ios/・server/・site/ の下の lint の設定と規則は、プロダクトのコードとしても待つ
      "ios/.swift-format",
      "ios/.swiftlint.yml",
      "server/.oxfmtrc.json",
      "server/.oxlintrc.json",
      "server/oxlint-plugin.js",
      "site/.oxfmtrc.json",
      "site/.oxlintrc.json",
    ],
  },
  {
    name: "照合を決めるもの",
    paths: [
      ".claude/agents/",
      ".codex/agents/",
      "CODING_STANDARDS.md",
      "docs/agents/review.md",
      ".agents/skills/steward/",
      // 仕様の照合は /code-review の Spec の軸で、skills-lock.json で入れる
      ".agents/skills/code-review/",
      "skills-lock.json",
    ],
  },
  {
    name: "照合が照らす決まりを書いた文書",
    paths: [
      "docs/agents/privacy.md",
      // 観測の道具に記録の中身を送らない決まりは、ルートの AGENTS.md にある。ほかのフォルダの AGENTS.md は当たらない
      "AGENTS.md",
      "docs/agents/coding-style.md",
      "docs/agents/languages/",
      "docs/agents/testing.md",
      // 文書の照合が照らす
      "docs/agents/decisions.md",
      ".agents/skills/writing-for-agents/",
    ],
  },
  {
    name: "merge を決めるもの",
    paths: [
      "scripts/merge-tier",
      "scripts/merge-tier.test.js",
      ".claude/settings.json",
      ".claude/hooks/",
      ".codex/config.toml",
      // 依存の PR のまとめ方を決め、patch と minor は dependency-pr.yml が merge する
      ".github/dependabot.yml",
      // Swift を上げる PR は、dependency-pr.yml が update-type を読まずに merge するので、何を上げるかがここで決まる
      ".github/workflows/update-swift-packages.yml",
      "scripts/update-swift-packages",
      "docs/agents/git.md",
      "docs/agents/issue-tracker.md",
      "docs/agents/dependencies.md",
    ],
  },
  {
    name: "壊れたら気づく道具",
    paths: [
      // deploy.yml は本番へも出すが、出したあとの /health と e2e を持つので、こちらに置く
      ".github/workflows/deploy.yml",
      ".github/workflows/ios-ui-test.yml",
      ".github/workflows/production-alerts.yml",
      "scripts/production-alerts",
      // scripts/production-alerts が Sentry の課題を読むのに使う
      "scripts/sentry",
    ],
  },
  // フェーズ1は本番へ出るもの（サーバーと site）を変えない前提で revert で戻すので、merge すると本番へ出す道具は入れない
  { name: "本番へ出すもの", paths: [".github/workflows/deploy-worker.yml", ".github/workflows/deploy-site.yml"] },
  { name: "用語・見た目・覆しにくい決定", paths: ["GLOSSARY.md", "DESIGN.md", "docs/adr/"] },
];

// 判定の値。出力の1行目にそのまま出る
const TIER = { phase1: "フェーズ1", phase2: "フェーズ2", wait: "待つ", research: "調べもの" };

const verdictOf = (classified) => {
  if (classified.length === 0) return TIER.wait;
  if (classified.every(({ tier }) => tier === TIER.research)) return TIER.research;
  if (classified.every(({ tier }) => tier === TIER.phase1)) return TIER.phase1;
  // プロダクトのコードを1つでも含めば、フェーズ1に当たるものと一緒でもフェーズ2の条件で通す
  return classified.every(({ tier }) => tier === TIER.phase1 || tier === TIER.phase2) ? TIER.phase2 : TIER.wait;
};

const formatPaths = (paths) => paths.map((path) => `\`${path}\``).join("、");

const matchesAny = (path, gatePaths) => gatePaths.some((gatePath) => matches(path, gatePath));

const matches = (path, gatePath) => (gatePath.endsWith("/") ? path.startsWith(gatePath) : path === gatePath);

const classify = ({ status, path }, agentDocuments) => {
  const gate = GATES.find(({ paths }) => matchesAny(path, paths));
  if (gate !== undefined) return { tier: TIER.wait, reason: `フェーズ1・フェーズ2に入れないもの（${gate.name}）` };
  // 調べものの PR は今の決まりのままにする。ほかと一緒に変えたときは、フェーズ1にも調べものにも当たらない
  if (path.startsWith("docs/research/")) return { tier: TIER.research, reason: "調べもの" };
  if (agentDocuments.has(path)) return { tier: TIER.phase1, reason: "エージェントが読む文書" };
  if (isTest(path)) {
    // 既存のテストを書き換える・消すと、守っていた振る舞いが変わりうるので、足すだけをフェーズ1にする
    if (status === "A") return { tier: TIER.phase1, reason: "テストを足すだけ" };
    return { tier: TIER.wait, reason: "既存のテストを書き換える・消す" };
  }
  if (TOOL_ROOTS.some((toolRoot) => path === toolRoot || path.startsWith(`${toolRoot}/`))) {
    return { tier: TIER.phase1, reason: "scripts/・CI・道具" };
  }
  if (matchesAny(path, LLM_REQUESTS.paths)) return { tier: TIER.wait, reason: `フェーズ2に入れないもの（${LLM_REQUESTS.name}）` };
  if (isProductCode(path)) return { tier: TIER.phase2, reason: "プロダクトのコード" };
  return { tier: TIER.wait, reason: "フェーズ1・フェーズ2に当たらない" };
};

// フェーズ2で通すプロダクトのコード。サーバーの TypeScript と、アプリの Swift だけにする。
// API の形（server/openapi.json、ios/OpenAPIGenerator/）、DB の移行、端末とサーバーの決めごと（shared/）、設定と依存、画像と色、site/ は当たらない。
// site/ は文言がそのまま本番に出て、フェーズ2の確かめ（verify-server・verify-ios）も無いので入れない
const isProductCode = (path) =>
  /^server\/src\/.+\.ts$/.test(path) || /^ios\/(NuTori|NuToriCore\/Sources)\/.+\.swift$/.test(path);

// LLM に送る指示・文脈の文面・要求を組むところと、評価（server/evals）と同じ決まりを使うところは、変えると評価を回し直す決まり
// （server/AGENTS.md の「テスト」、docs/agents/server-llm.md）なので、プロダクトのコードでもフェーズ2に入れない
const LLM_REQUESTS = {
  name: "LLM への指示と要求",
  paths: [
    "server/src/estimation/durable-object/create-estimation-provider/",
    "server/src/reply/durable-object/create-conversation-provider/",
    "server/src/durable-object/anthropic/",
    "server/src/reply/domain/build-reply-context/",
    "server/src/reply/domain/render-reply-context/",
    "server/src/reply/domain/list-referable-meal-ids.ts",
    "server/src/estimation/domain/compose-labeled-ingredient.ts",
    "server/src/estimation/domain/is-valid-identified-dishes.ts",
  ],
};

// 道具の置き場。サーバーに出るコードもアプリも変えない
const TOOL_ROOTS = ["scripts", ".github", ".claude", ".agents", ".codex", ".cursor", ".mobilebuildmcp", ".mcp.json", "pstack-lock.json"];

// テストのファイルの置き場は CODING_STANDARDS.md の「文書」のテストの条件と同じ。scripts/ のテストは道具として見る
const isTest = (path) =>
  /^(server|site)\/.*\.test\.tsx?$/.test(path) ||
  /^(server|site)\/(.+\/)?testing\//.test(path) ||
  /^ios\/(NuToriCore\/Tests|NuToriTests|NuToriUITests)\//.test(path);

// どれがエージェントが読む文書かは、scripts/agent-docs-duplicates が決める（scripts/check と同じ口を使う）
const pickAgentDocuments = (paths) => {
  const result = spawnSync(process.execPath, [join(root, "scripts/agent-docs-duplicates"), "--pick", root], {
    input: paths.join("\n"),
    encoding: "utf8",
  });
  if (result.status !== 0) throw new Error(`scripts/agent-docs-duplicates --pick が落ちた: ${result.stderr}`);
  return new Set(result.stdout.split("\n").filter((line) => line !== ""));
};

process.exitCode = main();
