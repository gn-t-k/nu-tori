#!/usr/bin/env bash
# shellcheck disable=SC1087,SC2329 # ひな形のライブラリの分。$e[ は bash では配列の添え字にならず、使わない helper も残す（docs/agents/tooling.md の「ウィザード」）
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1 && tput clear 2>/dev/null; then return 0; fi
  printf '\033[2J\033[3J\033[H'
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else false; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any, with write_env's single
# quotes or a plain dotenv double-quoted value undone.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line value sq="'\\''"; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  value="${line#*=}"
  if [[ "$value" == \'*\' ]]; then value="${value:1:${#value}-2}"; value="${value//"$sq"/\'}"
  elif [[ "$value" == \"*\" ]]; then
    value="${value:1:${#value}-2}"
    [[ "$value" == *[\\\$\"]* ]] && return 1   # escapes, $ or ": can't decode safely; ask again
  fi
  printf '%s' "$value"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret), edited
# with Readline. Fails at EOF with no input.
ask() {
  local key="$1" prompt="$2" current input s=$'\001' e=$'\002' p rc=0
  current=$(_existing "$key" || true)
  # Readline needs the colour codes wrapped in \001..\002 to place the cursor.
  p="  $s$BOLD$e$prompt$s$RESET$e "
  [[ -n "$current" ]] && p+="$s$DIM$e[Enter keeps current]$s$RESET$e "
  read -e -r -p "$p" input || rc=1
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input rc=0
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || rc=1
  printf '\n'
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY='VALUE' into ENV_FILE (replaces any existing
# line) and sets $KEY. Idempotent. Creates ENV_FILE at mode 0600; writes through
# a symlink and keeps an existing file's mode.
write_env() {
  local key="$1" value="$2" tmp sq="'\\''"
  [[ -e "$ENV_FILE" ]] || (umask 077 && : > "$ENV_FILE")
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf "%s='%s'\n" "$key" "${value//\'/$sq}" >> "$tmp"
  cat "$tmp" > "$ENV_FILE"
  rm -f "$tmp"
  printf -v "$key" '%s' "$value"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# Keep every stage inside run_wizard and the last line as is: bash then parses
# the whole file before the first prompt, so an edit mid-run can't break it.
# ──────────────────────────────────────────────────────────────────────────

# 見つけてもらう役（#738）が流入の数を読むための鍵を、開発者が作ってクラウドの環境 nu-tori-discovery に置く（#910）。開発者が Mac で回す
# 鍵はファイルにも .env にも GitHub にも書かない。値は最後の段でクリップボードに写し、環境の設定画面に貼ってもらう
# 申し込み（ONGOING）が stoppedDueToInactivity で止まったときは、最初の問いで「出し直すだけ」を選ぶと、その段だけを回す

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APP_ID="6816842705"
ASC_CONSOLE="https://appstoreconnect.apple.com/access/integrations/api"
GSC_KEY_FILE=""
ASC_ISSUER_ID=""
ASC_SALES_KEY_ID=""
ASC_SALES_KEY_FILE=""
ASC_ADMIN_KEY_ID=""
ASC_ADMIN_KEY_FILE=""
CF_ANALYTICS_TOKEN=""

# ask_value [ask|ask_secret] VAR "問い" は、空でない値を受け取るまで聞き直す。値の要る段で、空のまま次へ進まないため
ask_value() {
  local reader="$1" key="$2" prompt="$3"
  while true; do
    "$reader" "$key" "$prompt" || exit 1
    [[ -n "${!key}" ]] && return
    warn "空のままでは進めない"
  done
}

# ask_file VAR "なにのファイルか" は、落としたファイルのパスを受け取る。Finder から端末へ落とすと、パスが入る
ask_file() {
  local key="$1" label="$2" path
  while true; do
    ask "$key" "${label}のパス（Finder から落としてよい）:" || exit 1
    path="${!key}"
    # Finder から落とすと、空白の前に \ が付き、末尾に空白が付く
    path="${path%"${path##*[![:space:]]}"}"
    path="${path//\\ / }"
    if [[ -f "$path" ]]; then
      printf -v "$key" '%s' "$path"
      return
    fi
    warn "ファイルが無い: $path"
  done
}

# remove_file "パス" "なにのファイルか" は、使い終えた鍵のファイルを、確かめてから消す
remove_file() {
  local path="$1" label="$2"
  [[ -n "$path" && -f "$path" ]] || return 0
  if confirm "${label}（${path}）を消す？ 消すと戻せない"; then
    rm -f "$path"
    step "消した: $path"
  else
    SKIPPED+=("${label}を消す: $path")
  fi
}

# base64_one_line "パス" は、改行の無い1行の base64 を出す（macOS と Linux の base64 は折り返しの既定が違う）
base64_one_line() {
  base64 < "$1" | tr -d '\n'
}

# request_ongoing_analytics_reports は、Admin のキーを一時的に作らせ、ONGOING の申し込みが無ければ1回送り、キーを取り消させる
# 送るのは、申し込みの一覧の GET と、ONGOING が無いときの POST だけ。JWT は scripts/app-store-connect の作り方を借りる
request_ongoing_analytics_reports() {
  say "レポートを作ってもらう申し込みは Admin のキーでしか送れない。キーは一時的に作り、送ったらすぐ取り消す。"
  open_url "$ASC_CONSOLE"
  step "Team Keys → + → Name: nu-tori-analytics-request-temporary、Access: Admin → Generate"
  step "作ったキーの行の Download で .p8 を落とす。Key ID と、表の上の Issuer ID を見る"
  ask_value ask ASC_ADMIN_KEY_ID "Admin のキーの Key ID:"
  ask_value ask ASC_ISSUER_ID "Issuer ID:"
  ask_file ASC_ADMIN_KEY_FILE "Admin のキーの .p8"
  say "申し込みを確かめ、無ければ送る（鍵はこの端末の中だけで使い、ファイルにも残さない）"
  # shellcheck disable=SC2016 # node に渡す JavaScript で、$ はシェルの展開ではない
  if ! ASC_SCRIPT="${REPO_ROOT}/scripts/app-store-connect" KEY_ID="$ASC_ADMIN_KEY_ID" ISSUER_ID="$ASC_ISSUER_ID" KEY_FILE="$ASC_ADMIN_KEY_FILE" APP_ID="$APP_ID" node -e '
    const { createPrivateKey } = require("node:crypto");
    const { signShortLivedJwt } = require(process.env.ASC_SCRIPT);
    const key = {
      keyId: process.env.KEY_ID,
      issuerId: process.env.ISSUER_ID,
      privateKey: createPrivateKey(require("node:fs").readFileSync(process.env.KEY_FILE, "utf8")),
    };
    const call = async (path, init = {}) => {
      const response = await fetch(`https://api.appstoreconnect.apple.com/v1${path}`, {
        ...init,
        headers: { Authorization: `Bearer ${signShortLivedJwt(key)}`, "Content-Type": "application/json" },
      });
      const body = await response.text();
      if (!response.ok) throw new Error(`${response.status} ${body}`);
      return JSON.parse(body);
    };
    (async () => {
      const existing = (await call(`/apps/${process.env.APP_ID}/analyticsReportRequests`)).data.filter(
        (request) => request.attributes.accessType === "ONGOING" && !request.attributes.stoppedDueToInactivity,
      );
      if (existing.length > 0) {
        console.log(`  ONGOING の申し込みはもうある: ${existing[0].id}（送らなかった）`);
        return;
      }
      const created = await call("/analyticsReportRequests", {
        method: "POST",
        body: JSON.stringify({
          data: {
            type: "analyticsReportRequests",
            attributes: { accessType: "ONGOING" },
            relationships: { app: { data: { type: "apps", id: process.env.APP_ID } } },
          },
        }),
      });
      console.log(`  ONGOING の申し込みを送った: ${created.data.id}`);
    })().catch((error) => {
      console.error(`  ${error.message}`);
      process.exitCode = 1;
    });
  '; then
    warn "申し込めなかった（上の誤りを見る）。Access が Admin か、Key ID と Issuer ID が合っているかを見る"
    note "キーを取り消す前なら、この段から回し直せる"
    exit 1
  fi
  note "最初のレポートは1〜2日でできる"
  step "App Store Connect に戻り、nu-tori-analytics-request-temporary の行の Revoke でキーを取り消す（戻せない）"
  pause "取り消したら Enter"
  remove_file "$ASC_ADMIN_KEY_FILE" "Admin のキーの .p8"
}

run_wizard() {

TOTAL_STAGES=8

banner "nu-tori: 流入の数を読む鍵を作り、環境 nu-tori-discovery に置く"

if confirm "止まった App Store Connect の申し込みを出し直すだけ？（はじめて回すときは N）"; then
  TOTAL_STAGES=1
  stage "App Store Connect: Admin のキーで ONGOING の申し込みを出し直し、すぐ取り消す"
  request_ongoing_analytics_reports
  finish
  return
fi

# ── 1 ───────────────────────────────────────────────────────────────────
stage "Search Console: Domain プロパティ nu-tori.app を足して Verify する"
say "済んでいれば Enter で次へ。DNS の TXT は、確かめたあとも消さない。"
open_url "https://search.google.com/search-console"
step "左上のプロパティの選び口 → + Add property → Domain に nu-tori.app と入れて Continue"
step "Verify domain ownership の画面で、google-site-verification=... の TXT の値を Copy する"
note "プロバイダーを選ぶ一覧が出たら Any DNS provider を選ぶ（Cloudflare が一覧にあるかは確かめていない）"
pause "TXT の値を写したら Enter"
open_url "https://dash.cloudflare.com/"
step "nu-tori.app → DNS → Records → Add record"
step "Type: TXT、Name: @、Content: 写した値 → Save（SPF の v=spf1 の TXT とは別の行として足す）"
pause "Save したら Enter"
step "Search Console に戻って Verify を押す"
note "失敗したら、DNS が広まるのを待って押し直す（数分から、長いと2〜3日かかりうる）"
pause "Verify が通ったら Enter"

# ── 2 ───────────────────────────────────────────────────────────────────
stage "Google Cloud: プロジェクトと Search Console API"
say "サービスアカウントを置くプロジェクトを1つ作り、Google Search Console API を有効にする。済んでいれば Enter で次へ。"
open_url "https://console.cloud.google.com/projectcreate"
step "Project name に nu-tori-search-console などと入れて CREATE"
note "Location（組織）は、次の段で鍵を作れなかったときに見直す"
pause "作ったら Enter"
open_url "https://console.cloud.google.com/apis/library/searchconsole.googleapis.com"
step "上でプロジェクトが今作ったものになっていることを見て、ENABLE を押す"
pause "有効にしたら Enter"

# ── 3 ───────────────────────────────────────────────────────────────────
stage "Google Cloud: サービスアカウントと JSON 鍵"
open_url "https://console.cloud.google.com/iam-admin/serviceaccounts"
step "+ CREATE SERVICE ACCOUNT → 名前に nu-tori-discovery などと入れて CREATE AND CONTINUE"
step "Permissions（プロジェクトの役割）は付けずに DONE（Search Console の権限は Search Console 側で付ける）"
step "作ったサービスアカウント → KEYS → ADD KEY → Create new key → JSON → CREATE。JSON が落ちる（二度と落とせない）"
warn "Key creation is not allowed（iam.disableServiceAccountKeyCreation）で止まったら:"
note "  ・組織の管理者として、このプロジェクトだけ例外にする（プロジェクトにタグ disableServiceAccountKeyCreation を not_enforced で付け、ポリシーの規則で外す）"
note "  ・または、組織に属さない（Location が No organization の）プロジェクトを作り直して、2 の段からやり直す"
note "  ・どちらもしないなら、ここで止めてエージェントに OAuth の道に替えるよう頼む"
ask_file GSC_KEY_FILE "落とした JSON 鍵"
GSC_EMAIL="$(node -e 'const k = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")); if (k.type !== "service_account" || !k.client_email) process.exit(1); process.stdout.write(k.client_email);' "$GSC_KEY_FILE")" \
  || { warn "サービスアカウントの JSON 鍵でない: $GSC_KEY_FILE"; exit 1; }
step "サービスアカウントのメール: ${GSC_EMAIL}"
pause "Enter で次へ"

# ── 4 ───────────────────────────────────────────────────────────────────
stage "Search Console: サービスアカウントを Restricted で足す"
open_url "https://search.google.com/search-console/users?resource_id=sc-domain%3Anu-tori.app"
note "開かなければ、プロパティ nu-tori.app → Settings → Users and permissions"
step "ADD USER → Email address に ${GSC_EMAIL} → Permission: Restricted → ADD"
if command -v pbcopy >/dev/null 2>&1; then
  printf '%s' "$GSC_EMAIL" | pbcopy
  note "メールをクリップボードに写した"
fi
pause "足したら Enter"

# ── 5 ───────────────────────────────────────────────────────────────────
stage "App Store Connect: Admin のキーで ONGOING の申し込みを1回送り、すぐ取り消す"
if confirm "ONGOING の申し込みはもう送り、Admin のキーも取り消した？"; then
  step "申し込みは済んでいるので、次へ進む"
else
  request_ongoing_analytics_reports
fi
pause "Enter で次へ"

# ── 6 ───────────────────────────────────────────────────────────────────
stage "App Store Connect: 読むだけの Sales and Reports のキー"
say "エージェントが Analytics Reports を読むためのキー。お金の環境の Finance のキーとは分ける。"
open_url "$ASC_CONSOLE"
step "Team Keys → + → Name: nu-tori-discovery、Access: Sales → Generate"
note "API の文書では Sales and Reports と呼ぶ役割。Access の一覧の名前が違えば、Sales を含むものを選ぶ"
step "作ったキーの行の Download で .p8 を落とす（二度と落とせない）"
ask_value ask ASC_SALES_KEY_ID "Sales のキーの Key ID:"
# Issuer ID はチームに1つで、5の段で聞いていれば同じ値を使う
[[ -n "$ASC_ISSUER_ID" ]] || ask_value ask ASC_ISSUER_ID "Issuer ID（表の上）:"
ask_file ASC_SALES_KEY_FILE "Sales のキーの .p8"

# ── 7 ───────────────────────────────────────────────────────────────────
stage "Cloudflare: Account Analytics Read だけのトークン"
open_url "https://dash.cloudflare.com/?to=/:account/api-tokens"
step "Create Token → Create Custom Token"
step "Token name: nu-tori-discovery-web-analytics"
step "Permissions: Account / Account Analytics / Read の1行だけ（ほかの行は足さない）"
step "Continue to summary → Create Token → 出たトークンを写す（二度と出ない）"
ask_value ask_secret CF_ANALYTICS_TOKEN "トークン:"

# ── 8 ───────────────────────────────────────────────────────────────────
stage "クラウドの環境 nu-tori-discovery に5つの値を貼る"
say "値はこの環境にだけ置く。nu-tori と nu-tori-finance には置かない。"
step "claude.ai/code のセッションのタイトルバーの環境の名前 → nu-tori-discovery の Edit を開く"
step "Environment variables の欄に、次の5行を足す（.env の形で、1行に 名前=値）"
note "  NU_TORI_GSC_SERVICE_ACCOUNT_KEY  … JSON 鍵を base64 の1行にしたもの"
note "  NU_TORI_ASC_SALES_KEY_ID・NU_TORI_ASC_SALES_ISSUER_ID・NU_TORI_ASC_SALES_PRIVATE_KEY（.p8 を base64 の1行にしたもの）"
note "  NU_TORI_CLOUDFLARE_ANALYTICS_READ_TOKEN"
block="NU_TORI_GSC_SERVICE_ACCOUNT_KEY=$(base64_one_line "$GSC_KEY_FILE")
NU_TORI_ASC_SALES_KEY_ID=${ASC_SALES_KEY_ID}
NU_TORI_ASC_SALES_ISSUER_ID=${ASC_ISSUER_ID}
NU_TORI_ASC_SALES_PRIVATE_KEY=$(base64_one_line "$ASC_SALES_KEY_FILE")
NU_TORI_CLOUDFLARE_ANALYTICS_READ_TOKEN=${CF_ANALYTICS_TOKEN}"
if command -v pbcopy >/dev/null 2>&1; then
  printf '%s\n' "$block" | pbcopy
  step "5行をクリップボードに写した。欄の末尾に貼って保存する（⌘V）"
  pause "保存したら Enter（クリップボードを空にする）"
  printf '' | pbcopy
else
  warn "pbcopy が無いので、次の5行を写して貼る（秘密の値が画面に出る）"
  pause "出してよければ Enter"
  printf '%s\n' "$block"
  pause "保存したら Enter"
  _clear
fi
block=""
remove_file "$GSC_KEY_FILE" "Search Console のサービスアカウントの JSON 鍵"
remove_file "$ASC_SALES_KEY_FILE" "Sales のキーの .p8"
step "環境 nu-tori-discovery で新しいセッションを始め、「scripts/search-console sites と scripts/app-store-connect と scripts/cloudflare web-analytics で、流入の数を1回読めるか確かめて」と頼む"
note "App Store Connect のレポートは、申し込みから1〜2日たってから読める"
SKIPPED+=("環境 nu-tori-discovery のセッションで、3つの取る先を1回読めるか確かめてもらう")
pause "Enter で終わる"

finish
}

run_wizard "$@"; exit
