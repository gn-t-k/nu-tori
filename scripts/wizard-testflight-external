#!/usr/bin/env bash
# ひな形のライブラリの誤検知（SC1087）と、使わない助け（SC2329）を黙らせる。ライブラリは直さない
# shellcheck disable=SC1087,SC2329
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1 && tput clear 2>/dev/null; then return 0; fi
  printf '\033[2J\033[3J\033[H'
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else false; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any, with write_env's single
# quotes or a plain dotenv double-quoted value undone.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line value sq="'\\''"; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  value="${line#*=}"
  if [[ "$value" == \'*\' ]]; then value="${value:1:${#value}-2}"; value="${value//"$sq"/\'}"
  elif [[ "$value" == \"*\" ]]; then
    value="${value:1:${#value}-2}"
    [[ "$value" == *[\\\$\"]* ]] && return 1   # escapes, $ or ": can't decode safely; ask again
  fi
  printf '%s' "$value"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret), edited
# with Readline. Fails at EOF with no input.
ask() {
  local key="$1" prompt="$2" current input s=$'\001' e=$'\002' p rc=0
  current=$(_existing "$key" || true)
  # Readline needs the colour codes wrapped in \001..\002 to place the cursor.
  p="  $s$BOLD$e$prompt$s$RESET$e "
  [[ -n "$current" ]] && p+="$s$DIM$e[Enter keeps current]$s$RESET$e "
  read -e -r -p "$p" input || rc=1
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input rc=0
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || rc=1
  printf '\n'
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY='VALUE' into ENV_FILE (replaces any existing
# line) and sets $KEY. Idempotent. Creates ENV_FILE at mode 0600; writes through
# a symlink and keeps an existing file's mode.
write_env() {
  local key="$1" value="$2" tmp sq="'\\''"
  [[ -e "$ENV_FILE" ]] || (umask 077 && : > "$ENV_FILE")
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf "%s='%s'\n" "$key" "${value//\'/$sq}" >> "$tmp"
  cat "$tmp" > "$ENV_FILE"
  rm -f "$tmp"
  printf -v "$key" '%s' "$value"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# Keep every stage inside run_wizard and the last line as is: bash then parses
# the whole file before the first prompt, so an edit mid-run can't break it.
# ──────────────────────────────────────────────────────────────────────────


# TestFlight の外部テストを始める（https://github.com/gn-t-k/nu-tori/issues/638）。
# 運用は「TestFlight の外部テストの運用」（#42）の解決コメントのとおり。ここでは決めずに手を動かす。
#   scripts/wizard-testflight-external        今日の分: ビルドを選ぶ → 実機の確認 → 審査 → 公開リンク → 案内
#   scripts/wizard-testflight-external after  テスターが入ったあとの分: テストユーザーに足す → 公開リンクを止める
# 書き取った値はリポジトリの外の ENV_FILE に置き、Issue にはエージェントが人数と日付だけを書く。

APP_ID=6816842705
ASC_TESTFLIGHT="https://appstoreconnect.apple.com/apps/${APP_ID}/testflight/ios"
DEVICE_CHECK_ISSUES="686 633 405"

copy_text() {
  if command -v pbcopy >/dev/null 2>&1; then
    printf '%s' "$1" | pbcopy
    note "（クリップボードに写した）"
  fi
}

show_text() {
  printf '\n%s\n\n' "$1" | sed 's/^/    /'
  copy_text "$1"
}

start_stages() {

TOTAL_STAGES=7

banner "TestFlight の外部テストを始める"

stage "外部に出すビルドを選ぶ"
say "外部に出すのは、このあとの実機の確認を通したビルドだけ（#42 の6）。"
say "アップロードから日の浅いものを選ぶ（試せるのはアップロードから90日）。"
if [[ -x scripts/app-store-connect ]] && command -v jq >/dev/null 2>&1; then
  note "TestFlight に配られた新しいビルド:"
  scripts/app-store-connect get "/v1/builds?filter[app]=${APP_ID}&sort=-uploadedDate&limit=5" \
    | jq -r '.data[] | "    ビルド \(.attributes.version)  \(.attributes.uploadedDate[0:10])  \(.attributes.processingState)"' \
    || warn "読めなかった。App Store Connect の TestFlight の画面で見る"
else
  open_url "$ASC_TESTFLIGHT"
fi
ask TF_BUILD "外部に出すビルド番号:"
write_env TF_BUILD "$TF_BUILD"

stage "ビルド ${TF_BUILD} を実機で確かめる"
say "iPhone の TestFlight で、ビルド ${TF_BUILD} を入れる（本番につながる）。"
say "外部テストは初めてなので、まだ開いている実機のチケットも今回の分に入る（#42 の7）:"
if command -v gh >/dev/null 2>&1; then
  for n in $DEVICE_CHECK_ISSUES; do
    gh api "repos/gn-t-k/nu-tori/issues/${n}" --jq '"    #\(.number) [\(.state)] \(.title)"' || true
  done
else
  for n in $DEVICE_CHECK_ISSUES; do note "    https://github.com/gn-t-k/nu-tori/issues/${n}"; done
fi
note "開いているものは、そのチケットの受け入れ条件で確かめて閉じる（落ちたら、外部に出す前に直す）。"
say "そのうえで、主な流れを一通り通す:"
step "サインイン（同意の文に利用規約とプライバシーポリシーのリンクがある）"
step "食事を撮って、推定されるまで"
step "体重の記録"
step "ヘルスケアの許可と読み書き"
step "記録忘れの通知（届く・押して落ちない）"
step "目標を立てる"
confirm "ビルド ${TF_BUILD} で全部通り、実機のチケットも閉じた？" \
  || { warn "通っていないところを直してから、もう一度このウィザードを回す"; exit 1; }

stage "テスト情報を入れる"
open_url "$ASC_TESTFLIGHT"
say "左の欄の「テスト情報」（Test Information）を開き、次を入れて保存する。"
note "画面の名前が違えば、近い項目に入れる。"
step "ベータ版 App の説明（Beta App Description）: 下の文"
show_text "朝の体重と、食べる前の写真1枚から、1日に食べる量の目安を出し、毎週計算し直すアプリです。食事は写真から料理と材料、カロリーと栄養を推定して記録します。"
pause "入れたら Enter"
step "フィードバック用メールアドレス: テスターに見えるので、nu-tori.app のアドレスにする"
step "プライバシーポリシーの URL: https://nu-tori.app/privacy"
copy_text "https://nu-tori.app/privacy"
step "マーケティング URL: 空のまま（LP は配信が始まってから出す）"
pause "入れたら Enter"
say "同じ画面の「ベータ版 App Review 情報」（Beta App Review Information）:"
step "連絡先の氏名・電話・メールを入れる（ここはリポジトリに書かない）"
step "「サインインが必要」のチェックは外し、デモアカウントは入れない（Sign in with Apple だけのため）"
step "審査メモ（Review Notes）: 下の文"
show_text "Sign in with Apple is the only sign-in method. Please sign in with your own Apple Account; no demo account is needed. Estimating a meal from a photo requires a network connection. Apple Health access is optional: meal and weight logging work without granting it. A 30-day free trial is available, so all features can be tried without purchasing.
サインインは Sign in with Apple だけです。審査の方ご自身の Apple アカウントでサインインできます。写真からの推定には通信が要ります。ヘルスケアは許可しなくても、食事と体重の記録を使えます。"
pause "保存したら Enter"

stage "外部のグループを作り、ビルドを審査に出す"
open_url "$ASC_TESTFLIGHT"
ask TF_GROUP "外部テストのグループ名（例: 身近な人）:"
write_env TF_GROUP "$TF_GROUP"
step "左の欄の「外部テスト」の横の「+」から、グループ「${TF_GROUP}」を作る"
step "グループの「ビルド」の「+」で、ビルド ${TF_BUILD} を足す"
step "「テスト内容」（What to Test）: 下の文"
show_text "はじめての外部テストの版です。サインイン、食事を撮って推定されるまで、体重の記録、ヘルスケアとの連携、記録忘れの通知、目標を立てるところを、ふだんの食事で試してください。気づいたことは、開発者に直接送ってください。"
step "自動で配る（Automatically notify testers）はオンのまま"
confirm "ビルド ${TF_BUILD} を TestFlight の審査に出す？（出すと取り下げるまで審査が進む）" \
  || { warn "出していない。出すときにもう一度回す"; exit 1; }
step "「審査に提出」（Submit for Review）を押す"
pause "提出したら Enter"
write_env TF_SUBMITTED_ON "$(date +%Y-%m-%d)"

stage "TestFlight の審査を待つ"
say "結果はメールと、グループのビルドの状態で分かる（多くは1日以内）。"
note "このウィザードは開いたまま待つ（止めて回し直すと、提出の段もまた通る。入れた値は残っていて Enter で進む）。"
ask TF_REVIEW_RESULT "結果（通った / 却下）:"
write_env TF_REVIEW_RESULT "$TF_REVIEW_RESULT"
ask TF_REVIEW_NOTES "審査で言われたこと（無ければ「なし」。人の名前やメールは書かない）:"
write_env TF_REVIEW_NOTES "$TF_REVIEW_NOTES"
if [[ "$TF_REVIEW_RESULT" == *却下* ]]; then
  warn "却下の文面をエージェントに渡して、直し方を決める。直したら回し直す"
  exit 1
fi

stage "公開リンクを作る"
open_url "$ASC_TESTFLIGHT"
ask TF_INVITEES "招く人数（3〜5人の知り合い。名前は入れない）:"
write_env TF_INVITEES "$TF_INVITEES"
step "グループ「${TF_GROUP}」の「テスター」で「公開リンクを作成」（Create Public Link）を押す"
step "人数の上限（Limit number of testers）をオンにし、${TF_INVITEES} にする"
step "テスターの条件（Tester Criteria）で、端末を iPhone、OS を iOS 26.0 以上にする（ADR-0013）"
step "フィードバックはオンのまま（届けば読むが、テスターには案内しない）"
pause "リンクができたら、コピーして Enter"
ask TF_LINK "公開リンク（https://testflight.apple.com/join/...）:"
write_env TF_LINK "$TF_LINK"

stage "案内を送る"
say "下の案内を、LINE などで一人ずつ送る（メールでの招待は使わない）。"
show_text "nu-tori のテスト版を入れる手順です。
1. iPhone が iOS 26 以上か確かめてください（設定 → 一般 → 情報 → iOS バージョン）。古ければ先にアップデートしてください
2. このリンクを開いて「TestFlight」を入れ、もう一度リンクを開いて nu-tori を入れてください
${TF_LINK}
3. 途中で聞かれる自動アップデートは「オン」にしてください
4. サインインしたら、アカウントの画面の「問い合わせ」から「テスター参加」と送ってください
5. 気づいたことは、ここ（LINE）で気軽に送ってください"
confirm "全員に送った？" || pause "送り終えたら Enter"
write_env TF_STARTED_ON "$(date +%Y-%m-%d)"

finish
say "エージェントに次を渡す（チケット #638 の解決コメントになる）:"
show_text "始めた日: ${TF_STARTED_ON}
審査に出した日: ${TF_SUBMITTED_ON}
グループ: ${TF_GROUP}
ビルド: ${TF_BUILD}
招いた人数: ${TF_INVITEES}
審査の結果: ${TF_REVIEW_RESULT}
審査で言われたこと: ${TF_REVIEW_NOTES}"
note "テスターから「テスター参加」が届き始めたら: scripts/wizard-testflight-external after"
}

after_stages() {

TOTAL_STAGES=2

banner "外部テスター: テストユーザーに足し、公開リンクを止める"

stage "「テスター参加」のアカウントをテストユーザーに足す"
say "問い合わせのフォームの回答で、「テスター参加」に付いたアカウント ID を見る。"
say "足し方は docs/agents/production-incidents.md の「テストユーザーを足す・外す」。"
TF_ADDED=0
while ask TF_ACCOUNT_ID "アカウント ID（終わったら空のまま Enter）:" && [[ -n "$TF_ACCOUNT_ID" ]]; do
  if confirm "本番の test_users に ${TF_ACCOUNT_ID} を足す？"; then
    if (cd server && pnpm exec wrangler d1 execute nu-tori-production --remote --env production \
      --command "INSERT INTO test_users (account_id) VALUES ('${TF_ACCOUNT_ID}')"); then
      TF_ADDED=$((TF_ADDED + 1))
    else
      warn "足せなかった。ID を確かめる（すでに足してあると重複で失敗する）"
    fi
  fi
done
note "今回足した人数: ${TF_ADDED}"

stage "全員が入ったら公開リンクを止める"
open_url "$ASC_TESTFLIGHT"
ask TF_JOINED "入った人数:"
write_env TF_JOINED "$TF_JOINED"
if confirm "招いた全員が入った？"; then
  step "グループ「${TF_GROUP:-（外部テストのグループ）}」の「テスター」で、公開リンクを無効にする（Disable Public Link）"
  pause "止めたら Enter"
  write_env TF_LINK_CLOSED_ON "$(date +%Y-%m-%d)"
else
  note "全員が入ったら、もう一度 after で回す"
fi

finish
say "エージェントに渡す: 入った人数 ${TF_JOINED}、テストユーザーに足した人数 ${TF_ADDED}"
}

run_wizard() {
  cd "$(git rev-parse --show-toplevel)"
  ENV_FILE="${HOME}/.nu-tori-testflight-external.env"
  case "${1:-}" in
    after) after_stages ;;
    "") start_stages ;;
    *) printf '使い方: scripts/wizard-testflight-external [after]\n' >&2; exit 2 ;;
  esac
}

run_wizard "$@"; exit
