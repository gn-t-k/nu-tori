#!/usr/bin/env bash
# 確かめる手順の入口。エージェントも人も CI も、これを呼ぶ
set -euo pipefail

main() {
    if [ "${1-}" = --pick-targets ]; then
        # 出力は CI が $GITHUB_OUTPUT に書くので、結果の行（on_exit）を混ぜない
        [ $# -eq 1 ] || usage_error
        pick_targets
        return
    fi

    local targets="" target
    while [ $# -gt 0 ]; do
        case "$1" in
            --fix) fix=true ;;
            --lint) lint_only=true ;;
            --only)
                [ $# -ge 2 ] && [ -n "$2" ] && [[ "$2" != -* ]] || usage_error
                only_testing+=("-only-testing:NuToriUITests/$2")
                shift
                ;;
            --repeat)
                [ $# -ge 2 ] && [[ "$2" =~ ^[1-9][0-9]*$ ]] || usage_error
                repeat="$2"
                shift
                ;;
            ios | ios-app | ios-ui-test | server) targets="$targets $1" ;;
            *) usage_error ;;
        esac
        shift
    done
    if [ -n "${only_testing[*]-}$repeat" ] && [[ "$targets " != *" ios-ui-test "* ]]; then
        usage_error
    fi
    # ios-app と ios-ui-test は整形と Lint を回さないので、--lint と組み合わせない
    if $lint_only && [[ "$targets " == *" ios-app "* || "$targets " == *" ios-ui-test "* ]]; then
        usage_error
    fi

    trap on_exit EXIT
    if [ -z "$targets" ]; then
        check_changed
        return
    fi
    for target in $targets; do
        check_target "$target"
    done
}

check_target() {
    # 対象の前提（swift や xcodebuild があるか）で落ちたとき、前の対象の手順の名前を出さない
    current_step=""
    case "$1" in
        ios) if $lint_only; then lint_ios; else check_ios; fi ;;
        ios-app) check_ios_app ;;
        ios-ui-test) check_ios_ui_test ;;
        server) if $lint_only; then lint_server; else check_server; fi ;;
    esac
}

# CI の changes ジョブもこれを呼び、出力を $GITHUB_OUTPUT に書く
pick_targets() {
    local files target paths
    # 文書（*.md）だけの変更では、確かめるものが無い
    files="$(grep -vE '\.md$' || true)"
    for target in ios server; do
        paths="$target/|shared/|scripts/check\$|\.github/workflows/check\.yml\$"
        # アプリの API のクライアントは、サーバーの OpenAPI の文書から生成する
        if [ "$target" = ios ]; then paths="$paths|server/openapi\.json\$"; fi
        if grep -qE "^($paths)" <<< "$files"; then
            echo "$target=true"
        else
            echo "$target=false"
        fi
    done
}

# CI がまだ見ていない分（まだ push していない変更と作業中の変更）が関わる対象だけを確かめる
check_changed() {
    local upstream base files picked run_ios=false run_server=false
    step "確かめる対象を選ぶ"
    upstream="$(git -C "$root" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2> /dev/null)" ||
        upstream=origin/main
    base="$(git -C "$root" merge-base "$upstream" HEAD 2> /dev/null)" || base=""
    if [ -z "$base" ] || ! files="$(changed_files "$base")"; then
        echo "${upstream} と比べられないので、server と ios の両方を確かめる"
        check_target server
        check_target ios
        return
    fi
    echo "${upstream} と比べて、まだ push していない変更と作業中の変更から選ぶ"

    picked="$(pick_targets <<< "$files")"
    [[ "$picked" == *ios=true* ]] && run_ios=true
    [[ "$picked" == *server=true* ]] && run_server=true
    report_target server "$run_server"
    report_target ios "$run_ios"
    if ! $run_ios && ! $run_server; then
        echo "確かめる対象が無い（文書だけの変更か、変更が無い）"
        return
    fi

    if $run_server; then
        check_target server
        # --fix が server/openapi.json を書き出し直すと、アプリの API のクライアントも生成し直す
        if ! $run_ios && files="$(changed_files "$base")" &&
            [[ "$(pick_targets <<< "$files")" == *ios=true* ]]; then
            echo "server の確かめのあとに ios に関わる変更（server/openapi.json など）があるので、ios も確かめる"
            run_ios=true
        fi
    fi
    if $run_ios; then
        check_target ios
    fi
}

# 呼ぶ側が ! や && の中で呼ぶと set -e が効かないので、git diff の失敗を自分で返す
# ファイルを移したとき、移す前のパスでも対象を選ぶので、移したとみなさず消えたと足したの2つで出す
changed_files() {
    git -C "$root" diff --name-only --no-renames "$1" || return 1
    git -C "$root" ls-files --others --exclude-standard
}

report_target() {
    if $2; then
        echo "  ${1}: 確かめる"
    else
        echo "  ${1}: 飛ばす（関わる変更が無い）"
    fi
}

check_ios() {
    lint_ios

    step "UI テストが確かめた画面のスクリーンショットを残しているか"
    local missing
    missing="$(missing_ui_test_screenshots "$ios"/NuToriUITests/*UITests.swift)"
    if [ -n "$missing" ]; then
        echo "$missing" >&2
        echo "上のテストの本体で attachScreenshot(of:named:) を呼ぶ（docs/agents/languages/swift.md「道具」）" >&2
        return 1
    fi

    step "Xcode のプロジェクトの依存が exactVersion か"
    if grep -A2 'requirement = {' "$ios/NuTori.xcodeproj/project.pbxproj" |
        grep 'kind = ' | grep -v 'kind = exactVersion'; then
        echo "Swift Package の依存は Exact Version で固定する（docs/agents/languages/swift.md「依存パッケージ」）" >&2
        return 1
    fi

    step "API のクライアントが OpenAPI の文書と合っているか"
    local generated="$ios/NuToriCore/Sources/NuToriAPI/Generated" output log
    output="$(mktemp -d)"
    # 生成器は設定の一覧を毎回出すので、失敗したときだけ見せる
    if ! log="$(swift run --package-path "$ios/OpenAPIGenerator" --force-resolved-versions -c release \
        swift-openapi-generator generate \
        --config "$ios/OpenAPIGenerator/openapi-generator-config.yaml" \
        --output-directory "$output" \
        "$server/openapi.json" 2>&1)"; then
        echo "$log" >&2
        return 1
    fi
    if $fix; then
        rm -rf "$generated"
        cp -R "$output" "$generated"
    fi
    if ! diff -ru "$generated" "$output"; then
        echo "ios/NuToriCore/Sources/NuToriAPI/Generated が古い。scripts/check ios --fix で生成し直す" >&2
        return 1
    fi

    step "両方に置く決めごとの Swift のファイルが shared/ と合っているか"
    local shared_rules="$ios/NuToriCore/Sources/NuToriCore/Generated"
    output="$(mktemp -d)"
    if ! log="$(swift run --package-path "$ios/SharedRulesGenerator" -c release \
        SharedRulesGenerator "$root/shared" "$output" 2>&1)"; then
        echo "$log" >&2
        return 1
    fi
    if $fix; then
        rm -rf "$shared_rules"
        cp -R "$output" "$shared_rules"
    fi
    if ! diff -ru "$shared_rules" "$output"; then
        echo "ios/NuToriCore/Sources/NuToriCore/Generated が古い。scripts/check ios --fix で書き出し直す" >&2
        return 1
    fi

    step "Xcode のプロジェクトの Package.resolved が NuToriCore と同じか"
    local resolved="$ios/NuTori.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved"
    if $fix; then
        cp "$ios/NuToriCore/Package.resolved" "$resolved"
    fi
    if ! diff -u "$resolved" "$ios/NuToriCore/Package.resolved"; then
        echo "Xcode のプロジェクトの Package.resolved が古い。scripts/check ios --fix で写し直す" >&2
        return 1
    fi

    if command -v xcodebuild > /dev/null; then
        check_ios_app
    else
        check_ios_package
        echo "xcodebuild が無いので、アプリのビルドとテストは macOS の CI に任せる"
    fi
}

# 全部は数分かかるので、機械で見分けられる決まりの破れを、書いた直後に早く見られるよう分けておく（--lint）
lint_ios() {
    if ! command -v swift > /dev/null; then
        echo "swift が無い。Linux では scripts/install-swift で入れる（SessionStart hook が入れている途中なら、install-swift はそれが終わるのを待つ）" >&2
        return 1
    fi

    step "整形（swift-format）"
    if $fix; then
        swift format format --in-place --recursive --parallel "$ios"
    fi
    swift format lint --strict --recursive --parallel "$ios"

    step "Lint（SwiftLint ${swiftlint_version}）"
    install_swiftlint
    if $fix; then
        (cd "$ios" && "$swiftlint" lint --fix --quiet)
    fi
    (cd "$ios" && "$swiftlint" lint --strict --quiet)
}

check_ios_app() {
    if ! command -v xcodebuild > /dev/null; then
        echo "ios-app は macOS でだけ動く" >&2
        return 1
    fi
    # Linux と macOS で Foundation の振る舞いが違うことがあるので、macOS でも回す
    check_ios_package

    step "アプリと UI テストのビルド"
    local simulator
    simulator="$(latest_iphone_simulator)"
    xcodebuild \
        -project "$ios/NuTori.xcodeproj" \
        -scheme NuTori \
        -destination "id=$simulator" \
        -disableAutomaticPackageResolution \
        build-for-testing
}

# いつ回すかは docs/agents/tooling.md の CI の節
check_ios_ui_test() {
    check_ios_app

    step "UI テスト"
    local results="$ios/.build/NuTori.xcresult" kana_keyboard="ja_JP-Kana@sw=Kana;hw=Automatic"
    # 1台のシミュレータでは同じアプリの UI テストを同時に回せないので、ほかのチェックアウトとぶつからないよう、回すたびに複製を作って消す
    # 消すのは on_exit
    clone_ui_test_simulator
    # 起動をテストの中でさせると、アプリの起動が時間切れになることがある
    boot_ui_test_simulator
    # Simulator.app でハードウェアキーボードを一度つなぐと、シミュレータがそれを覚えてソフトウェアキーボードを画面の外へ最小化し、キーを押すテストが落ちる。まっさらなシミュレータ（CI）では起きないので、Mac でもそろえる
    xcrun simctl spawn "$ui_test_simulator" defaults write com.apple.keyboard.preferences AutomaticMinimizationEnabled -bool false
    # キーボードの並びと最初に出るキーボードはシミュレータの言語で決まり、英語のランナー（CI）ではかなが出ない。かなを打つテストのために、どこでもかなを入れて、最後に使ったキーボードにする（最初に出る）。テストの中で地球儀のキーで切り替えると、初めての案内がキーボードを覆う
    xcrun simctl spawn "$ui_test_simulator" defaults write -g AppleKeyboards -array "$kana_keyboard" "en_US@sw=QWERTY;hw=Automatic" "emoji@sw=Emoji"
    xcrun simctl spawn "$ui_test_simulator" defaults write com.apple.keyboard.preferences KeyboardLastUsed "$kana_keyboard"
    rm -rf "$results"
    local repeat_options=()
    if [ -n "$repeat" ]; then
        repeat_options=(-test-iterations "$repeat" -run-tests-until-failure)
    fi
    # テストの診断をシミュレータから集めると、テストが通った回でも時間切れの10分まで待つことがある。落ちた理由は xcresult で足りる
    xcodebuild \
        -project "$ios/NuTori.xcodeproj" \
        -scheme NuTori \
        -destination "id=$ui_test_simulator" \
        -resultBundlePath "$results" \
        -collect-test-diagnostics never \
        ${only_testing[@]+"${only_testing[@]}"} \
        ${repeat_options[@]+"${repeat_options[@]}"} \
        test-without-building
}

check_ios_package() {
    step "ロジックのパッケージのテスト"
    swift test --package-path "$ios/NuToriCore" --force-resolved-versions
}

check_server() {
    lint_server

    step "型検査（tsc）"
    (cd "$server" && pnpm exec tsc)

    step "OpenAPI の文書が経路のスキーマと合っているか"
    local document
    document="$(cd "$server" && pnpm exec tsx scripts/print-openapi-document.ts)"
    if $fix; then
        echo "$document" > "$server/openapi.json"
    fi
    if ! diff -u "$server/openapi.json" - <<< "$document"; then
        echo "server/openapi.json が古い。scripts/check server --fix で書き出し直す" >&2
        return 1
    fi

    # SKILL.md への写しは人かエージェントが判断するので、--fix でも写しを書き換えない
    step "byethrow の skill の元の instruction が、入っている @praha/byethrow-docs と合っているか"
    local instruction instruction_copy=".agents/skills/byethrow/upstream-instruction.md"
    instruction="$(cd "$server" && pnpm exec tsx scripts/print-byethrow-docs-instruction.ts)"
    if ! diff -u "$root/$instruction_copy" - <<< "$instruction"; then
        cat >&2 << MESSAGE
@praha/byethrow-docs の instruction が、写し（${instruction_copy}）から変わった。--fix では直さない
1. 上の差分（- が写し、+ が入っている版）のうち変わった分を、.agents/skills/byethrow/SKILL.md に写す（このリポジトリの書き方に合わせて直す）
2. リポジトリのルートで、写しを新しくする: pnpm --dir server exec tsx scripts/print-byethrow-docs-instruction.ts > $instruction_copy
MESSAGE
        return 1
    fi

    step "テスト（Vitest）"
    (cd "$server" && pnpm exec vitest run)
}

# 整形と Lint だけ。oxlint は型を見るので、Worker の型の宣言も書き出す（--lint）
lint_server() {
    step "サーバーの依存（pnpm）"
    (cd "$server" && pnpm install --frozen-lockfile)

    step "整形（oxfmt）"
    if $fix; then
        (cd "$server" && pnpm exec oxfmt)
    fi
    (cd "$server" && pnpm exec oxfmt --check)

    step "Worker の型の宣言（wrangler types）"
    (cd "$server" && pnpm exec wrangler types > /dev/null)

    step "Lint（oxlint）"
    if $fix; then
        (cd "$server" && pnpm exec oxlint --fix)
    fi
    (cd "$server" && pnpm exec oxlint)
}

print_usage() {
    cat << 'USAGE'
使い方: scripts/check [ios | ios-app | ios-ui-test | server] [--fix]
       scripts/check [ios | server] --lint [--fix]
       scripts/check ios-ui-test [--only <クラス>[/<メソッド>]]... [--repeat <回数>]
       scripts/check --pick-targets < <変わったファイルの一覧>
  引数なし     まだ push していない変更（push 先が無ければ origin/main から分かれた点から）と作業中の変更が関わる、server と ios。
               文書（*.md）だけなら何も回さない。比べる先が取れなければ両方。全部を回すときは ios server と並べる
  ios          整形、Lint、API のクライアントと両方に置く決めごとの書き出しが最新か、ロジックのパッケージのテスト。macOS では続けて ios-app も
  ios-app      ロジックのパッケージのテストと、アプリと UI テストのビルド（macOS だけ）
  ios-ui-test  ios-app に続けて、UI テスト（macOS だけ）
  server       整形、Lint、型検査、OpenAPI の文書と byethrow の instruction の写しが最新か、テスト
  --fix        直せるものを直してから確かめる
  --lint       ios と server の整形と Lint だけを回す。書いたらまずこれを回し、通ってから全部を回す。対象を省くと、引数なしと同じ選び方をする
  --only       UI テストを、そのクラスかメソッドだけにする。重ねて指定できる
  --repeat     UI テストを、落ちるまで最大その回数くり返す。揺れを再現するときに使う
  --pick-targets  標準入力の変わったファイルの一覧から、確かめる対象を ios=<true|false> と server=<true|false> の2行で出す（CI 向け）
USAGE
}

usage_error() {
    print_usage >&2
    exit 2
}

step() {
    current_step="$*"
    echo "==> $*"
}

# 出力を tail に通すと終了コードが見えないので、最後の行に結果を出す
on_exit() {
    local status=$?
    if [ -n "$ui_test_simulator" ]; then
        # set -e は trap の中でも効くので、消せなくても結果の行は出す
        xcrun simctl delete "$ui_test_simulator" || echo "UI テストの複製 ${ui_test_simulator} を消せない" >&2
    fi
    if [ "$status" -eq 0 ]; then
        echo "scripts/check: OK"
    else
        echo "scripts/check: FAILED${current_step:+（${current_step}）}"
    fi
}

# 版と SHA-256 を固定した SwiftLint を、無ければ .tools/ に落とし、パスを swiftlint に入れる
install_swiftlint() {
    local asset sha256
    case "$(uname -s)-$(uname -m)" in
        Linux-x86_64)
            asset=swiftlint_linux_amd64.zip
            sha256=caeed6f4a679c35539ffaf124f6c4ab4a8416917f7d8796279dc52b74026059d
            ;;
        Linux-aarch64)
            asset=swiftlint_linux_arm64.zip
            sha256=9ffa52f478e6d8eb485d37d14715ffac90abc81c58f3370d598bf75be05605f8
            ;;
        Darwin-*)
            asset=portable_swiftlint.zip
            sha256=c1e429b0599cf1b516f369a2d9ec04eaf0e436f3c12b637df8851fa52ff694d0
            ;;
        *)
            echo "SwiftLint の配布物が無い環境: $(uname -s)-$(uname -m)" >&2
            return 1
            ;;
    esac
    local dir="$root/.tools/swiftlint-$swiftlint_version"
    # custom rules を使うので、Linux でも swiftlint-static ではなく swiftlint を使う
    if [ ! -x "$dir/swiftlint" ]; then
        mkdir -p "$dir"
        curl -fsSL -o "$dir/$asset" \
            "https://github.com/realm/SwiftLint/releases/download/$swiftlint_version/$asset"
        if command -v sha256sum > /dev/null; then
            echo "$sha256  $dir/$asset" | sha256sum -c - >&2
        else
            echo "$sha256  $dir/$asset" | shasum -a 256 -c - >&2
        fi
        unzip -oq "$dir/$asset" -d "$dir"
        rm "$dir/$asset"
    fi
    swiftlint="$dir/swiftlint"
}

# attachScreenshot を本体で直に呼ばない test メソッドを「ファイル: func test_…」の形で出す。メソッドの終わりは、次の func かファイルの終わりとみなす（テストの中に func を入れ子にすると、そこで終わったとみなす）
missing_ui_test_screenshots() {
    awk '
        function report() {
            if (test != "" && !shot) print file ": " test
            test = ""
        }
        FNR == 1 { report(); file = FILENAME }
        !/^[[:space:]]*\/\// && /(^|[[:space:]])func[[:space:]]/ {
            report()
            shot = 0
            if ($0 ~ /func test/) {
                test = $0
                sub(/^[[:space:]]*/, "", test)
                sub(/\(.*/, "", test)
            }
        }
        !/^[[:space:]]*\/\// && /attachScreenshot\(/ { shot = 1 }
        END { report() }
    ' "$@"
}

# いちばん新しい iOS のランタイムの、最初の iPhone のシミュレータの ID
latest_iphone_simulator() {
    local id
    id="$(xcrun simctl list devices available | awk '
        /^-- iOS / { ios = 1; picked = 0; next }
        /^-- / { ios = 0; next }
        ios && !picked && /^ +iPhone/ {
            match($0, /\([0-9A-F-]{36}\)/)
            latest = substr($0, RSTART + 1, 36)
            picked = 1
        }
        END { print latest }
    ')"
    if [ -z "$id" ]; then
        echo "iPhone のシミュレータが無い" >&2
        return 1
    fi
    echo "$id"
}

# UI テストに使う複製を、複製の元から作って ID を ui_test_simulator に入れる
# 起動中のシミュレータは複製できず、共有の iPhone はほかのセッションが起動していることがあるので、テストに使わない複製の元を持つ
clone_ui_test_simulator() {
    local prefix="nu-tori ui-test" base_name="nu-tori ui-test-base" latest device_type runtime base lock
    latest="$(latest_iphone_simulator)"
    read -r device_type runtime < <(list_simulators_with_runtime | jq -r --arg id "$latest" \
        '.[] | select(.udid == $id) | "\(.deviceTypeIdentifier) \(.runtime)"') || true
    if [ -z "$device_type" ] || [ -z "$runtime" ]; then
        echo "シミュレータ $latest の機種とランタイムが取れない" >&2
        return 1
    fi

    # 2つのチェックアウトが同時に複製の元を作ったり、同じ置き去りの複製を消したりしないよう、ロックを持つ
    lock="${TMPDIR:-/tmp}/nu-tori-ui-test-base.lock"
    until shlock -f "$lock" -p $$; do
        sleep 1
    done
    delete_abandoned_ui_test_simulators "$prefix"
    base="$(list_simulators_with_runtime | jq -r --arg name "$base_name" --arg type "$device_type" --arg runtime "$runtime" \
        'first(.[] | select(.name == $name and .deviceTypeIdentifier == $type and .runtime == $runtime) | .udid) // empty')"
    if [ -z "$base" ]; then
        echo "UI テストの複製の元（${base_name}）を作る" >&2
        # Xcode を上げてランタイムが変わったら、前の元は使わない
        list_simulators_with_runtime | jq -r --arg name "$base_name" '.[] | select(.name == $name) | .udid' |
            xargs -n 1 xcrun simctl delete
        base="$(xcrun simctl create "$base_name" "$device_type" "$runtime")"
        # 初めての起動は数十秒かかるので、元で一度済ませ、複製の起動を数秒にする
        xcrun simctl bootstatus "$base" -b > /dev/null
    fi
    # 作る途中で止まった元や、人が起動した元も複製できるよう、落としてから複製する。落ちている元では失敗するので、失敗は見ない
    xcrun simctl shutdown "$base" 2> /dev/null || true
    ui_test_simulator="$(xcrun simctl clone "$base" "$prefix $$")"
    rm -f "$lock"
}

# 壁紙のポスターを作る係（PosterBoard）は、起動のたびに数十の拡張を立ち上げる。CI のランナーではそれが数分ふさぎ、アプリの起動と終了が時間切れになる（#354）。切った設定は複製に引き継がれないので、起動のたびに、立ち上がる前に切る
boot_ui_test_simulator() {
    local service error tries=0
    service="user/$(id -u)/com.apple.PosterBoard"
    xcrun simctl boot "$ui_test_simulator"
    # 起動の途中は spawn が通らないので、通るまで試し直す
    until error="$(xcrun simctl spawn "$ui_test_simulator" launchctl disable "$service" 2>&1)"; do
        tries=$((tries + 1))
        if [ "$tries" -ge 120 ]; then
            echo "シミュレータの PosterBoard を切れない: $error" >&2
            return 1
        fi
        sleep 0.5
    done
    # 切る前に立ち上がっていたら止める。立ち上がっていなければ失敗するので、失敗は見ない
    xcrun simctl spawn "$ui_test_simulator" launchctl bootout "$service" 2> /dev/null || true
    xcrun simctl bootstatus "$ui_test_simulator" -b
}

# kill -9 などで消し損ねた UI テストの複製を、名前の pid のプロセスが居なければ消す
delete_abandoned_ui_test_simulators() {
    local prefix="$1" udid pid
    list_simulators_with_runtime | jq -r --arg prefix "$prefix " \
        '.[] | select(.name | startswith($prefix)) | "\(.udid) \(.name | ltrimstr($prefix))"' |
        while read -r udid pid; do
            if [[ "$pid" =~ ^[0-9]+$ ]] && ! kill -0 "$pid" 2> /dev/null; then
                xcrun simctl delete "$udid"
            fi
        done
}

list_simulators_with_runtime() {
    xcrun simctl list devices -j | jq '[.devices | to_entries[] | .key as $runtime | .value[] | . + {runtime: $runtime}]'
}

