#!/usr/bin/env bash
# GitHub に書いた Issue・PR・コメントの本文を読み直し、手元の元の本文と比べる。
# 書くと書式が崩れることがあるので（docs/agents/git.md「クラウドのセッションで GitHub を操作する」）、書いたら毎回これで確かめる
set -euo pipefail

usage() {
    cat >&2 << 'USAGE'
使い方: scripts/diff-posted <元の本文のファイル> <API のパス>
  API のパス  issues/<番号>（Issue と PR の本文）、issues/comments/<ID>（コメント）、pulls/<番号>
同じなら 0、違えば差分を出して 1 で終わる。末尾の署名と空行、行末の空白、CR は比べない
USAGE
    exit 2
}

# 末尾に自動で足される署名は、コメントと PR で形が違い、セッションの URL が付くこともある
normalize() {
    tr -d '\r' | sed -E 's/[[:space:]]+$//' | awk '
        { line[NR] = $0 }
        END {
            n = NR
            while (n > 0 && (line[n] == "" || line[n] == "---" ||
                line[n] ~ /^_Generated by \[Claude Code\]\(.*\)_$/ ||
                line[n] ~ /^🤖 Generated with \[Claude Code\]\(.*\)$/ ||
                line[n] ~ /^https:\/\/claude\.ai\/code\/session_[A-Za-z0-9]+$/)) n--
            for (i = 1; i <= n; i++) print line[i]
        }'
}

[ $# -eq 2 ] && [ -f "$1" ] || usage
case "$2" in
    issues/[0-9]* | issues/comments/[0-9]* | pulls/[0-9]*) ;;
    *) usage ;;
esac

posted="$(gh api "repos/gn-t-k/nu-tori/$2" --jq .body)"
if diff -u --label 元の本文 --label "書いた本文（$2）" <(normalize < "$1") <(normalize <<< "$posted"); then
    echo "同じ"
else
    exit 1
fi
