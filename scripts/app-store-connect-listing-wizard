#!/usr/bin/env bash
# shellcheck disable=SC1087,SC2329 # ひな形のライブラリの分。$e[ は bash では配列の添え字にならず、使わない helper も残す（docs/agents/tooling.md の「ウィザード」）
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1 && tput clear 2>/dev/null; then return 0; fi
  printf '\033[2J\033[3J\033[H'
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else false; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any, with write_env's single
# quotes or a plain dotenv double-quoted value undone.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line value sq="'\\''"; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  value="${line#*=}"
  if [[ "$value" == \'*\' ]]; then value="${value:1:${#value}-2}"; value="${value//"$sq"/\'}"
  elif [[ "$value" == \"*\" ]]; then
    value="${value:1:${#value}-2}"
    [[ "$value" == *[\\\$\"]* ]] && return 1   # escapes, $ or ": can't decode safely; ask again
  fi
  printf '%s' "$value"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret), edited
# with Readline. Fails at EOF with no input.
ask() {
  local key="$1" prompt="$2" current input s=$'\001' e=$'\002' p rc=0
  current=$(_existing "$key" || true)
  # Readline needs the colour codes wrapped in \001..\002 to place the cursor.
  p="  $s$BOLD$e$prompt$s$RESET$e "
  [[ -n "$current" ]] && p+="$s$DIM$e[Enter keeps current]$s$RESET$e "
  read -e -r -p "$p" input || rc=1
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input rc=0
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || rc=1
  printf '\n'
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY='VALUE' into ENV_FILE (replaces any existing
# line) and sets $KEY. Idempotent. Creates ENV_FILE at mode 0600; writes through
# a symlink and keeps an existing file's mode.
write_env() {
  local key="$1" value="$2" tmp sq="'\\''"
  [[ -e "$ENV_FILE" ]] || (umask 077 && : > "$ENV_FILE")
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf "%s='%s'\n" "$key" "${value//\'/$sq}" >> "$tmp"
  cat "$tmp" > "$ENV_FILE"
  rm -f "$tmp"
  printf -v "$key" '%s' "$value"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# Keep every stage inside run_wizard and the last line as is: bash then parses
# the whole file before the first prompt, so an edit mid-run can't break it.
# ──────────────────────────────────────────────────────────────────────────


# nu-tori の掲載情報と設定を App Store Connect に入れる。値は掲載情報のモジュール（site/src/app-store-connect-listing.ts）から出し、1欄ずつクリップボードに写す
# 段に書いた答えの出どころは docs/agents/ios-release.md の「App Store に出す」。何も .env や GitHub に書かない

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APP_ID="6816842705"
ASC_APP="https://appstoreconnect.apple.com/apps/${APP_ID}/distribution"
# 本番の Worker の経路（server/wrangler.jsonc の本番の routes）と、通知の受け口（server/src/http/app-store-server-notification-routes/）
NOTIFICATION_URL="https://api.nu-tori.app/v1/app-store-server-notifications"
LISTING_JSON=""

# stop "なぜ" は、先に進めない理由を出して止まる。直したら最初から回し直す（入れた値は App Store Connect に残るので、入れ終えた段は Enter で進められる）
stop() {
  printf '\n'
  warn "$1"
  note "直したら、最初から回し直す。入れ終えた段は Enter で進められる"
  printf '\n'
  exit 1
}

# gate "問い" "いいえのときの理由" は、はいでなければ止まる
gate() { confirm "$1" || stop "$2"; }

# listing_js '<j を受ける JavaScript の式>' は、掲載情報の JSON から値を出す
listing_js() {
  node -e 'const j = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")); const v = (0, eval)("(j) => " + process.argv[2])(j); process.stdout.write(typeof v === "string" ? v : JSON.stringify(v));' "$LISTING_JSON" "$1"
}

# paste_field "欄" "値" は、値を見せてクリップボードに写し、貼り終えるまで待つ
paste_field() {
  local label="$1" value="$2"
  printf '\n  %s%s%s\n' "$BOLD" "$label" "$RESET"
  printf '%s\n' "$value" | sed 's/^/    │ /'
  if command -v pbcopy >/dev/null 2>&1; then
    printf '%s' "$value" | pbcopy
    note "クリップボードに写した。欄の中身を消してから貼る（⌘V）"
  else
    note "上の値を写して、欄の中身を消してから貼る"
  fi
  pause "貼ったら Enter"
}

run_wizard() {

TOTAL_STAGES=16

cd "$REPO_ROOT"

banner "nu-tori: App Store Connect に掲載情報と設定を入れる"

# ── 1 ───────────────────────────────────────────────────────────────────
stage "main の最新と、掲載情報を確かめる"
say "入れる値は main の掲載情報のモジュールから出す。仮の文が残っていたら、ここで止まる。"
git fetch --quiet origin main || stop "origin の main を取れなかった"
if [[ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ]]; then
  stop "今の HEAD が origin/main と違う。git switch main && git pull してから回す"
fi
if [[ -n "$(git status --porcelain --untracked-files=no -- site server)" ]]; then
  stop "site/ か server/ に作業中の変更がある。main のままの値を入れるため、片づけてから回す"
fi
[[ -d site/node_modules ]] || stop "site の依存が無い。pnpm install --dir site してから回す"
LISTING_JSON="$(mktemp)"
trap 'rm -f "$LISTING_JSON"' EXIT
(cd site && node src/app-store-connect-listing-command.ts json) > "$LISTING_JSON" \
  || stop "掲載情報を読めなかった（上の誤りを見る）"
drafts="$(cd site && node src/app-store-connect-listing-command.ts drafts)" \
  || stop "仮の文の欄が残っている: $(printf '%s' "$drafts" | tr '\n' ' ')。文言を決める PR が main に入ってから回す"
step "main の最新で、仮の文は残っていない"
pause "Enter で次へ"

# ── 2 ───────────────────────────────────────────────────────────────────
stage "出すビルドと、本番の最低バージョン"
say "審査に出すビルドが、本番のサーバーに締め出されないことを確かめる。"
step "出すビルドは、TestFlight の内部テストに配られ、実機で確かめたもの（ios-release.md の「実機の確認」）"
ask SUBMIT_BUILD "出すビルドの番号:"
[[ "$SUBMIT_BUILD" =~ ^[1-9][0-9]*$ ]] || stop "ビルドの番号は数字だけで入れる: ${SUBMIT_BUILD}"
minimum_build="$(sed -n 's/.*"MINIMUM_APP_BUILD": *\([0-9][0-9]*\).*/\1/p' server/wrangler.jsonc | head -n 1)"
[[ -n "$minimum_build" ]] || stop "server/wrangler.jsonc に MINIMUM_APP_BUILD が見つからない"
say "本番の最低バージョン（main の server/wrangler.jsonc の MINIMUM_APP_BUILD）: ${minimum_build}"
(( SUBMIT_BUILD >= minimum_build )) \
  || stop "出すビルド ${SUBMIT_BUILD} が最低バージョン ${minimum_build} より古く、本番に締め出される"
step "main の server/ の変更が本番に出ているかを、deploy の最後の回で見る"
if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
  gh run list --repo gn-t-k/nu-tori --workflow deploy.yml --branch main --limit 1 || true
else
  open_url "https://github.com/gn-t-k/nu-tori/actions/workflows/deploy.yml?query=branch%3Amain"
fi
gate "main の deploy の最後の回は success か" "main の deploy を通してから回す（server/AGENTS.md の「デプロイ」）"
note "BILLING_STARTED_ON（課金を始める日）は、公開した日に #708 で合わせる。ここでは見ない"

# ── 3 ───────────────────────────────────────────────────────────────────
stage "本番の LLM の費用の上限"
say "本番の推定と返事が使う Anthropic のワークスペースの上限が、決めた額のままかを見る。"
say "額の正本は docs/agents/production-incidents.md の「費用の知らせ」。"
open_url "https://platform.claude.com/"
step "Console でワークスペース nu-tori-production に切り替え、上限（Limits）の画面を開く"
step "月の上限（spend limit）が \$300"
step "知らせ（spend notification）が \$50・\$100・\$200"
step "請求（Billing）の自動の補充が「\$30 を下回ったら \$100 まで」で、支払い方法が切れていない"
gate "3つとも、このとおりか" "上限か知らせが違う。production-incidents.md の額に直してから回す（額を変えるなら、先にその文書を直す）"

# ── 4 ───────────────────────────────────────────────────────────────────
stage "App Store のサーバー通知の URL"
say "審査と TestFlight の購入は Sandbox なので、本番と Sandbox の両方が本番のサーバーに向いている必要がある（#647）。"
open_url "${ASC_APP}/info"
step "App 情報（App Information）の「App Store サーバー通知」（App Store Server Notifications）を見る"
say "本番サーバー URL と Sandbox サーバー URL の両方が、次になっている。バージョンは 2"
paste_field "通知の URL" "$NOTIFICATION_URL"
gate "本番と Sandbox の両方が、この URL のバージョン 2 か" "通知の URL を直して保存してから回す"

# ── 5 ───────────────────────────────────────────────────────────────────
stage "App 情報: 名前、サブタイトル、カテゴリ、コンテンツ配信権"
open_url "${ASC_APP}/info"
step "右上の言語が「日本語」になっていることを見る（英語の掲載情報は作らない）"
paste_field "名前（Name）" "$(listing_js 'j.name')"
paste_field "サブタイトル（Subtitle）" "$(listing_js 'j.subtitle.text')"
step "カテゴリ: プライマリを「$(listing_js 'j.primaryCategory')」（Health & Fitness）にし、セカンダリは空のまま"
step "コンテンツ配信権（Content Rights）: 「第三者のコンテンツを含み、使う権利がある」と答える"
note "  文部科学省の日本食品標準成分表の値を見せる。許諾は要らない（docs/research/launch-legal-checks.md の問い3）"
step "右上の「保存」を押す"
pause "保存したら Enter"

# ── 6 ───────────────────────────────────────────────────────────────────
stage "App 情報: 年齢制限指定（9+ にする）"
say "#597 の解決コメントの 12。Medical を Infrequent と答えると 13+ になり、「医療・治療の情報」と出る。"
open_url "${ASC_APP}/info"
step "「年齢制限指定」（Age Rating）の編集を開き、次のとおり答える"
say ""
say "  In-App Controls      Parental Controls / Age Assurance                 → いいえ"
say "  Capabilities         Unrestricted Web Access                            → いいえ"
say "                       User-Generated Content                             → いいえ"
say "                       Social Media                                       → いいえ"
say "                       Messaging and Chat（ユーザーどうし。AI との会話は当たらない）→ いいえ"
say "                       Advertising                                        → いいえ"
say "  Mature Themes        Profanity / Horror / Alcohol, Tobacco, or Drug     → なし（None）"
say "  Medical or Wellness  Medical or Treatment Information                   → なし（None）"
say "                       Health or Wellness Topics（calorie tracking）      → はい"
say "  Sexuality or Nudity  すべて                                             → なし（None）"
say "  Violence             すべて                                             → なし（None）"
say "  Chance-Based         Simulated Gambling / Contests                      → なし（None）"
say "                       Gambling / Loot Boxes                              → いいえ"
say "  Made for Kids とほかの上書き（Age Rating Override）                      → いいえ・上げない"
say ""
note "AI の返事も頻度に数える。会話の返事は病名を挙げない（#637）ので、Medical は None"
note "ここに無い問いが出たら、答えずに止め、エージェントに聞く"
gate "結果が 9+ になったか（保存まで済ませる）" "9+ にならなかった。答えを見直すか、エージェントに聞く"

# ── 7 ───────────────────────────────────────────────────────────────────
stage "App のプライバシー: ポリシーの URL と、集めるデータの種類"
say "回答の表の正本は #861 の解決コメント。ここではその表を写す。"
open_url "${ASC_APP}/privacy"
step "プライバシーポリシーの URL の編集を開き、次を貼って保存する"
paste_field "プライバシーポリシーの URL" "$(listing_js 'j.urls.privacyPolicy')"
step "データの収集の問いを開き、「はい、この App からデータを収集します」を選ぶ"
step "次の 15 の種類だけにチェックを入れる。ほかは入れない"
say ""
say "  連絡先情報（Contact Info）      メールアドレス（Email Address）"
say "  健康とフィットネス              健康（Health）            ※ フィットネス（Fitness）は入れない"
say "  位置情報（Location）            おおよその位置情報（Coarse Location）"
say "  ユーザーコンテンツ              写真またはビデオ / カスタマーサポート / その他のユーザーコンテンツ"
say "  ID（Identifiers）               ユーザ ID / デバイス ID"
say "  購入（Purchases）               購入履歴（Purchase History）"
say "  使用状況データ（Usage Data）    製品の操作（Product Interaction） / その他の使用状況データ"
say "  診断（Diagnostics）             クラッシュデータ / パフォーマンスデータ / その他の診断データ"
say "  その他のデータ                  その他のデータタイプ（Other Data Types）"
say ""
gate "15 の種類を選んで保存したか" "#861 の解決コメントの表と照らして、選び直す"

# ── 8 ───────────────────────────────────────────────────────────────────
stage "App のプライバシー: 種類ごとの答えと公開"
open_url "${ASC_APP}/privacy"
say "どの種類でも、ユーザーに結びつく（Linked）は「はい」、トラッキングは「いいえ」。"
say "使い道は次の2つだけを選ぶ（AF = App の機能 / AN = アナリティクス）。ほかの使い道は選ばない。"
say ""
say "  メールアドレス              AF"
say "  健康                        AF, AN"
say "  おおよその位置情報          AF"
say "  写真またはビデオ            AF"
say "  カスタマーサポート          AF, AN"
say "  その他のユーザーコンテンツ  AF"
say "  ユーザ ID                   AF, AN"
say "  デバイス ID                 AF, AN"
say "  購入履歴                    AF, AN"
say "  製品の操作                  AN"
say "  その他の使用状況データ      AF, AN"
say "  クラッシュデータ            AF"
say "  パフォーマンスデータ        AF, AN"
say "  その他の診断データ          AF"
say "  その他のデータタイプ        AF"
say ""
step "15 の種類を答え終えたら、右上の「公開」（Publish）を押す"
gate "公開まで済ませたか" "答えを #861 の解決コメントの表と照らして、公開してから回す"

# ── 9 ───────────────────────────────────────────────────────────────────
stage "価格および配信状況"
open_url "${ASC_APP}/pricing"
step "価格: 無料（0 円）。課金はアプリ内のサブスクリプションだけ（#647）"
step "配信状況: 国と地域を「日本」だけにする。ほかの国は外す"
step "今後足される国や地域へ自動で配信する設定があれば、外す"
step "「Apple シリコン搭載 Mac」（iPhone and iPad Apps on Apple Silicon Macs）で入手可能を外す（ADR-0004）"
step "予約注文はしない（#594 の 12）"
step "保存する"
gate "配信が日本だけで、Mac で入手可能が外れているか" "配信の国と Mac の設定を直して保存してから回す"

# ── 10 ──────────────────────────────────────────────────────────────────
stage "版のページ: プロモーション用テキスト"
open_url "${ASC_APP}/ios/version/inflight"
step "審査に出す版のページを、言語「日本語」で開く"
paste_field "プロモーション用テキスト（Promotional Text）" "$(listing_js 'j.promotionalText.text')"

# ── 11 ──────────────────────────────────────────────────────────────────
stage "版のページ: 説明文"
paste_field "概要・説明文（Description）" "$(listing_js 'j.description.text')"

# ── 12 ──────────────────────────────────────────────────────────────────
stage "版のページ: キーワードと URL"
paste_field "キーワード（Keywords）" "$(listing_js 'j.keywords')"
note "欄の残りの字数が負になっていないことを見る（上限が 100 バイトか 100 字かは文書が食い違う）"
paste_field "サポート URL（Support URL）" "$(listing_js 'j.urls.support')"
paste_field "マーケティング URL（Marketing URL）" "$(listing_js 'j.urls.marketing')"
step "右上の「保存」を押す"
pause "保存したら Enter"

# ── 13 ──────────────────────────────────────────────────────────────────
stage "版のページ: スクリーンショット 5 枚"
screenshot_dir="site/src/app-store-screenshot-images"
screenshot_names="$(listing_js 'j.screenshots.map((s) => s.name).join(" ")')"
for name in $screenshot_names; do
  [[ -f "${screenshot_dir}/${name}.png" ]] || stop "${screenshot_dir}/${name}.png が無い。合成し直してから回す（site/AGENTS.md の「合成する」）"
done
say "上げるもの: ${screenshot_dir}/ の ${screenshot_names}（この順）"
command -v open >/dev/null 2>&1 && open "${REPO_ROOT}/${screenshot_dir}"
large_result="$(grep -m 1 '^確かめた結果: ' docs/agents/ios-release.md || true)"
if [[ -n "$large_result" ]]; then
  step "6.9 インチの欄に、上の画像をこの順で上げ直す。古い画像は消す"
  note "ほかの大きさは要らないと確かめてある（ios-release.md の「${large_result}」）"
  pause "上げて保存したら Enter"
else
  step "docs/agents/ios-release.md の「上げる前に、large の大きさだけで足りるかを確かめる」の 1〜3 のとおり上げて見る"
  step "  6.9 インチの欄に、上の画像をこの順で上げる。古い画像があれば消す"
  step "  「メディアマネージャですべてのサイズを表示」で、ほかの大きさが「6.9 インチのものを使用」かを見る"
  step "  保存し、スクリーンショットが足りないという警告が出ないかを見る"
  if confirm "6.9 インチ（large）だけで足りたか"; then
    SKIPPED+=("エージェントに「large だけで足りた（$(date +%Y-%m-%d)）」と伝え、ios-release.md のその節に「確かめた結果: 」の1行を書いてもらう")
  else
    SKIPPED+=("エージェントに「large だけでは足りず、medium（6.3 インチ）が要る」と伝え、書き出す Issue を立ててもらう（審査に出す前に要る）")
  fi
fi

# ── 14 ──────────────────────────────────────────────────────────────────
stage "版のページ: 著作権と App Review に関する情報"
paste_field "著作権（Copyright）の頭" "$(listing_js 'j.copyrightPrefix')"
step "貼った「2026 」の後ろに、販売元と同じ氏名を打つ。氏名はここにだけ入れ、リポジトリ・Issue には書かない"
step "「App Review に関する情報」の「サインインが必要です」のチェックを外す。ユーザ名とパスワードは空のまま"
note "  Sign in with Apple だけで、デモアカウントは渡さない。道は審査へのメモに書く（ios-release.md の「App Store に出す」）"
step "連絡先（名前・メール・電話）に、審査の人から連絡を受ける人を入れる。電話は +81 から"
step "メモの中身を消して、次を貼る"
paste_field "メモ（Notes）" "$(listing_js 'j.reviewNotes')"

# ── 15 ──────────────────────────────────────────────────────────────────
stage "版のページ: リリースの方法と保存"
step "「App Store バージョンのリリース」で「このバージョンを手動でリリースする」を選ぶ"
note "  審査が通ったら、LP を出す PR と時機をそろえて、開発者が手で公開する（ios-release.md の「審査に出す」）"
step "右上の「保存」を押す"
warn "ビルドを付けること、サブスクリプション2つを選ぶこと、審査に出すことは、ここではしない（ios-release.md の「審査に出す」）"
gate "手動のリリースにして保存したか" "リリースの方法を直して保存してから回す"

# ── 16 ──────────────────────────────────────────────────────────────────
stage "エージェントに読み返してもらう"
say "エージェントは読むだけの鍵で App Store Connect を読み、掲載情報のモジュールと突き合わせる。"
step "エージェントに「App Store Connect の読み返しをして」と頼む（ios-release.md の「読み返す」）"
note "App のプライバシーと、価格および配信状況は鍵で読めない。7〜9 の段で見たものを、そのまま伝える"
SKIPPED+=("エージェントに「App Store Connect の読み返し」を頼む")
pause "Enter で終わる"

finish
}

run_wizard "$@"; exit
