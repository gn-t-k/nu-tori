#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser; visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# ──────────────────────────────────────────────────────────────────────────
# #242 の「落ちた PR の Issue」を本物で一度確かめる。確かめ終わったら、このスクリプトは消す
# Dependabot の PR に、必ず落ちるテストを足すコミットを push し、Issue が立つ → recreate で消す → マージされて Issue が閉じる、を見る

TOTAL_STAGES=7

REPO=gn-t-k/nu-tori
POLL_SECONDS=15
BREAK_FILE=server/test/break-for-242.test.ts

# wait_until "説明" コマンド…: コマンドが成り立つまで、POLL_SECONDS ごとに繰り返す。Ctrl-C で抜けられる
wait_until() {
  local what="$1"
  shift
  printf '  %s%s を待っている（%s 秒ごとに見る。Ctrl-C で止める）%s\n  ' "$DIM" "${what}" "${POLL_SECONDS}" "$RESET"
  until "$@"; do
    printf '.'
    sleep "$POLL_SECONDS"
  done
  printf '\n'
}

# Dependabot の開いている PR の「番号 ブランチ」を1行ずつ出す
open_dependabot_prs() {
  gh pr list --repo "$REPO" --author app/dependabot --state open \
    --json number,headRefName --jq '.[] | "\(.number) \(.headRefName)"'
}

# 始めたときに無かった、Dependabot の開いている PR があれば、PR_NUMBER と PR_BRANCH に入れる
new_dependabot_pr_appeared() {
  local number branch
  while read -r number branch; do
    [[ -z "$number" ]] && continue
    if ! grep -qx "$number" <<< "$KNOWN_PRS"; then
      PR_NUMBER="$number"
      PR_BRANCH="$branch"
      return 0
    fi
  done <<< "$(open_dependabot_prs)"
  return 1
}

# PR の先頭が SHA のときの check が、終わっていれば結論を CHECK_CONCLUSION に入れる
check_finished_on() {
  local sha="$1" line
  line="$(gh run list --repo "$REPO" --workflow check --commit "$sha" \
    --json status,conclusion,url --jq '.[0] | select(.status == "completed") | "\(.conclusion) \(.url)"')"
  [[ -z "$line" ]] && return 1
  CHECK_CONCLUSION="${line%% *}"
  CHECK_URL="${line#* }"
}

# dependency-pr.yml の track-failure と同じ題の、開いている Issue があれば ISSUE_NUMBER と ISSUE_URL に入れる
failure_issue_opened() {
  local line
  line="$(TITLE_KEY="依存の PR #${PR_NUMBER} の check が落ちている" \
    gh issue list --repo "$REPO" --state open --limit 100 --json number,title,url \
    --jq '[.[] | select(.title | contains(env.TITLE_KEY))][0] | select(. != null) | "\(.number) \(.url)"')"
  [[ -z "$line" ]] && return 1
  ISSUE_NUMBER="${line%% *}"
  ISSUE_URL="${line#* }"
}

pr_head_sha() {
  gh pr view "$PR_NUMBER" --repo "$REPO" --json headRefOid --jq .headRefOid
}

pr_head_changed_from() {
  [[ "$(pr_head_sha)" != "$1" ]]
}

pr_closed() {
  PR_STATE="$(gh pr view "$PR_NUMBER" --repo "$REPO" --json state --jq .state)"
  [[ "$PR_STATE" != "OPEN" ]]
}

issue_closed() {
  [[ "$(gh issue view "$ISSUE_NUMBER" --repo "$REPO" --json state --jq .state)" == "CLOSED" ]]
}

banner "#242 落ちた PR の Issue を確かめる"

# ──────────────────────────────────────────────────────────────────────────
stage "準備"
if ! command -v gh > /dev/null 2>&1 || ! gh auth status > /dev/null 2>&1; then
  warn "gh が無いか、ログインしていない。gh auth login をしてから、もう一度走らせる"
  exit 1
fi
ROOT="$(git rev-parse --show-toplevel)"
say "gh にログインしている。リポジトリ: ${ROOT}"
say "このあと、Dependabot の PR のブランチに、必ず落ちるテスト（${BREAK_FILE}）を足すコミットを push する。"
say "手元の作業ツリーは触らず、一時的な worktree で push する。"
pause "Enter で進む"

# ──────────────────────────────────────────────────────────────────────────
stage "Dependabot の PR を待つ"
KNOWN_PRS="$(open_dependabot_prs | cut -d' ' -f1)"
if [[ -n "$KNOWN_PRS" ]]; then
  note "今開いている Dependabot の PR（これらは使わず、新しく開くものを待つ）: $(tr '\n' ' ' <<< "$KNOWN_PRS")"
fi
say "Dependabot を今走らせるか、月曜の 9:00 を待つ。今走らせるなら:"
open_url "https://github.com/${REPO}/network/updates"
step "npm（/server）の行の「Recent update jobs」を開き、「Check for updates」を押す"
note "上げるものがあれば、数分で npm のグループの PR が出る（手元なら cd server && pnpm outdated で分かる）"
note "check は4分ほどで通ってマージされるので、PR が出たらすぐ次に進む"
wait_until "Dependabot の新しい PR" new_dependabot_pr_appeared
say "PR #${PR_NUMBER}（${PR_BRANCH}）が出た"
open_url "https://github.com/${REPO}/pull/${PR_NUMBER}"

# ──────────────────────────────────────────────────────────────────────────
stage "落ちるテストを足して push する"
say "PR #${PR_NUMBER} のブランチ ${PR_BRANCH} に、${BREAK_FILE} を足すコミットを push する。"
say "マージされる前に push すれば、先に走った check が通っていても、dependency-pr はマージしない。"
if ! confirm "push する？"; then
  warn "push しなかった。PR #${PR_NUMBER} は check が通ればマージされる"
  exit 1
fi
if [[ "$(gh pr view "$PR_NUMBER" --repo "$REPO" --json state --jq .state)" != "OPEN" ]]; then
  warn "PR #${PR_NUMBER} はもう開いていない（間に合わなかった）。次の PR でもう一度走らせる"
  exit 1
fi
WORKTREE="$(mktemp -d)"
git -C "$ROOT" fetch --quiet origin "$PR_BRANCH"
git -C "$ROOT" worktree add --quiet --detach "$WORKTREE" FETCH_HEAD
cat > "${WORKTREE}/${BREAK_FILE}" << 'TS'
import { expect, test } from "vitest";

// #242 の確かめのために足した、必ず落ちるテスト。@dependabot recreate で消える
test("落ちた依存の PR の Issue を確かめる", () => {
  expect(1).toBe(2);
});
TS
git -C "$WORKTREE" add "$BREAK_FILE"
git -C "$WORKTREE" commit --quiet -m "#242 の確かめのため、必ず落ちるテストを足す"
BROKEN_SHA="$(git -C "$WORKTREE" rev-parse HEAD)"
git -C "$WORKTREE" push --quiet origin "HEAD:refs/heads/${PR_BRANCH}"
git -C "$ROOT" worktree remove --force "$WORKTREE"
say "push した: ${BROKEN_SHA}"
pause "Enter で進む"

# ──────────────────────────────────────────────────────────────────────────
stage "check が落ちて Issue が立つのを見る"
wait_until "${BROKEN_SHA:0:7} の check" check_finished_on "$BROKEN_SHA"
if [[ "$CHECK_CONCLUSION" != "failure" ]]; then
  warn "check の結論が ${CHECK_CONCLUSION} だった（failure のはず）: ${CHECK_URL}"
  pause "Enter で、それでも Issue を待つ"
fi
say "check: ${CHECK_URL}"
wait_until "dependency-pr が Issue を立てる" failure_issue_opened
open_url "$ISSUE_URL"
say "Issue #${ISSUE_NUMBER} で、次を見る:"
step "ラベルが ready-for-agent"
step "題が「依存の PR #${PR_NUMBER} の check が落ちている（PR の題）」で、[セキュリティ] の印は無い"
step "本文に、PR へのリンクと、落ちた回（${CHECK_URL}）へのリンクがある"
step "本文に、直し方（PR のブランチで始めたセッションで直す、recreate で足したコミットが消える）がある"
if confirm "仕様どおりだった？"; then ISSUE_OK=yes; else ISSUE_OK=no; fi

# ──────────────────────────────────────────────────────────────────────────
stage "@dependabot recreate で出し直す"
say "PR #${PR_NUMBER} に「@dependabot recreate」とコメントし、足したコミットを消させる。"
if ! confirm "コメントする？"; then
  warn "コメントしなかった。PR #${PR_NUMBER} は落ちたまま残っている。手で recreate するか、閉じる"
  exit 1
fi
gh pr comment "$PR_NUMBER" --repo "$REPO" --body "@dependabot recreate" > /dev/null
say "コメントした"
wait_until "Dependabot が PR を出し直す" pr_head_changed_from "$BROKEN_SHA"
say "出し直された"
pause "Enter で進む"

# ──────────────────────────────────────────────────────────────────────────
stage "マージされて Issue が閉じるのを見る"
wait_until "PR #${PR_NUMBER} が閉じる（check が通り、App がマージする）" pr_closed
if [[ "$PR_STATE" != "MERGED" ]]; then
  warn "PR #${PR_NUMBER} はマージされずに閉じた（${PR_STATE}）"
fi
MERGED_BY="$(gh pr view "$PR_NUMBER" --repo "$REPO" --json mergedBy --jq '.mergedBy.login // ""')"
say "PR #${PR_NUMBER}: ${PR_STATE}（マージしたのは ${MERGED_BY:-なし}）"
wait_until "Issue #${ISSUE_NUMBER} が閉じる" issue_closed
open_url "$ISSUE_URL"
step "Issue に「PR がマージされた: …」のコメントが付き、完了で閉じている"
if confirm "そうなっていた？"; then CLOSE_OK=yes; else CLOSE_OK=no; fi

# ──────────────────────────────────────────────────────────────────────────
stage "#242 に記録する"
say "#242 に貼る文面の下書き（違ったところがあれば書き足す）:"
printf '\n'
cat << NOTE
「落ちた PR の Issue」の項目を、本物で一度確かめた。

- PR: https://github.com/${REPO}/pull/${PR_NUMBER}
- 落ちるテストを足したコミット ${BROKEN_SHA:0:7} の check: ${CHECK_URL}（${CHECK_CONCLUSION}）
- Issue: ${ISSUE_URL}（仕様どおり: ${ISSUE_OK}）
- @dependabot recreate で出し直し、${MERGED_BY:-（マージされず）} が merge した。Issue にコメントが付いて閉じた（${CLOSE_OK}）
NOTE
printf '\n'
open_url "https://github.com/${REPO}/issues/242"
pause "コメントを書いたら Enter"

finish
