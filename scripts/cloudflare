#!/usr/bin/env bash
# エージェントと人が Cloudflare の、例外にならない振る舞い（Workers Logs、呼び出しの数・誤り・CPU 時間）と、`nu-tori.app` の DMARC の集計と、LP の訪問の集計（Web Analytics）を読む。環境の対応と呼ぶ先を、ここ1か所に置く
set -euo pipefail

usage() {
    cat >&2 <<'EOF'
使い方:
  scripts/cloudflare logs <development|production> [何分前から（既定 60）] [parameters に足す JSON]
    例: scripts/cloudflare logs production 60 '{"needle":{"value":"alarm"}}'
  scripts/cloudflare metrics <development|production> [何時間前から（既定 24）]
  scripts/cloudflare dmarc [何日前から（既定 7）]
  scripts/cloudflare web-analytics [何日前から（既定 7、93 まで）]
EOF
    exit 2
}
[ $# -ge 1 ] || usage
command="$1"
shift

case "$command" in
    logs | metrics)
        [ $# -ge 1 ] || usage
        # 環境に既定を置かない。付け忘れで、開発用と本番を取り違えないため
        case "$1" in
            development) worker="nu-tori-development" ;;
            production) worker="nu-tori-production" ;;
            *) usage ;;
        esac
        shift
        ;;
    # DMARC の報告と LP の訪問はドメインのもので、環境の区別が無い
    dmarc | web-analytics) ;;
    *) usage ;;
esac

# 何分前・何時間前・何日前は正の整数だけを受ける。分を省いて JSON を渡すと、JSON が分として読まれるため
since="${1:-}"
case "$since" in
    '') ;;
    0 | *[!0-9]*) usage ;;
esac
# RUM の問い合わせは、1回で 93 日より前を読めない
if [ "$command" = web-analytics ] && [ "${since:-7}" -gt 93 ]; then usage; fi

# LP の訪問の集計は Account Analytics Read だけのトークンで読む。Workers Logs を読めるトークンを、見つけてもらう役の環境（nu-tori-discovery）に置かないため
# アカウントの ID は、そのトークンが見る1つのアカウントから引く（scripts/finance と同じ）。置く値を1つにするため
# デプロイ用の CLOUDFLARE_API_TOKEN（書き込みの権限）は使わない
if [ "$command" = web-analytics ]; then
    if [ -z "${NU_TORI_CLOUDFLARE_ANALYTICS_READ_TOKEN:-}" ]; then
        echo "Not authenticated: NU_TORI_CLOUDFLARE_ANALYTICS_READ_TOKEN が要る" >&2
        exit 1
    fi
    token="$NU_TORI_CLOUDFLARE_ANALYTICS_READ_TOKEN"
else
    if [ -z "${NU_TORI_CLOUDFLARE_ACCOUNT_ID:-}" ] || [ -z "${NU_TORI_CLOUDFLARE_READ_TOKEN:-}" ]; then
        echo "Not authenticated: NU_TORI_CLOUDFLARE_ACCOUNT_ID と NU_TORI_CLOUDFLARE_READ_TOKEN が要る" >&2
        exit 1
    fi
    token="$NU_TORI_CLOUDFLARE_READ_TOKEN"
fi
api="https://api.cloudflare.com/client/v4"

get_json() {
    curl --silent --show-error --fail-with-body -H "Authorization: Bearer $token" "$1"
}

post_json() {
    curl --silent --show-error --fail-with-body -H "Authorization: Bearer $token" \
        -H "Content-Type: application/json" --data @- "$1"
}

# GraphQL は、問い合わせの誤りや権限の不足を HTTP 200 と errors で返すので、errors があれば失敗として抜ける
fail_on_graphql_errors() {
    node -e '
        let body = "";
        process.stdin.on("data", (chunk) => (body += chunk)).on("end", () => {
            console.log(body);
            // つながらない・5xx の HTML のように JSON でない本文は、原因が JSON の解釈に見えないよう、本文だけ出して失敗にする
            try {
                if (JSON.parse(body).errors?.length) process.exitCode = 1;
            } catch {
                process.exitCode = 1;
            }
        });'
}

case "$command" in
    logs)
        extra="${2:-}"
        [ -n "$extra" ] || extra='{}'
        # shellcheck disable=SC2016 # node に渡す JavaScript で、$ はシェルの展開ではない
        WORKER="$worker" MINUTES="${since:-60}" EXTRA="$extra" node -e '
            const { view = "events", limit = 100, filters = [], ...parameters } = JSON.parse(process.env.EXTRA);
            const now = Date.now();
            console.log(JSON.stringify({
                queryId: "agent-adhoc",
                view,
                limit,
                timeframe: { from: now - Number(process.env.MINUTES) * 60_000, to: now },
                parameters: {
                    ...parameters,
                    // 環境の Worker に必ず絞る。絞らないと、アカウントのすべての Worker のログが混ざる
                    filters: [{ key: "$metadata.service", operation: "eq", type: "string", value: process.env.WORKER }, ...filters],
                },
            }));' | post_json "$api/accounts/$NU_TORI_CLOUDFLARE_ACCOUNT_ID/workers/observability/telemetry/query"
        ;;
    metrics)
        # shellcheck disable=SC2016 # node に渡す JavaScript で、$ はシェルの展開ではない
        ACCOUNT="$NU_TORI_CLOUDFLARE_ACCOUNT_ID" WORKER="$worker" HOURS="${since:-24}" node -e '
            const end = new Date();
            const start = new Date(end - Number(process.env.HOURS) * 3_600_000);
            console.log(JSON.stringify({
                query: `query ($accountTag: string!, $scriptName: string!, $start: Time!, $end: Time!) {
                    viewer { accounts(filter: { accountTag: $accountTag }) {
                        workersInvocationsAdaptive(limit: 1000, orderBy: [datetimeHour_ASC], filter: { scriptName: $scriptName, datetime_geq: $start, datetime_leq: $end }) {
                            sum { requests errors subrequests }
                            quantiles { cpuTimeP50 cpuTimeP99 wallTimeP99 }
                            dimensions { datetimeHour status }
                        }
                    } }
                }`,
                variables: { accountTag: process.env.ACCOUNT, scriptName: process.env.WORKER, start: start.toISOString(), end: end.toISOString() },
            }));' | post_json "$api/graphql" | fail_on_graphql_errors
        ;;
    dmarc)
        # shellcheck disable=SC2016 # node に渡す JavaScript で、$ はシェルの展開ではない
        zone="$(get_json "$api/zones?name=nu-tori.app" | node -e '
            let body = "";
            process.stdin.on("data", (chunk) => (body += chunk)).on("end", () => {
                // JSON でない本文は、fail_on_graphql_errors と同じく本文だけ出して失敗にする
                let id;
                try {
                    id = JSON.parse(body).result?.[0]?.id;
                } catch {
                    console.error(body);
                    process.exitCode = 1;
                    return;
                }
                if (id) console.log(id);
                else {
                    // 名前の誤りやトークンの範囲の不足では、成功の形の空の一覧が返り、本文だけでは原因が読めない
                    console.error(`nu-tori.app の zone が見つからない（トークンの範囲を確かめる）: ${body}`);
                    process.exitCode = 1;
                }
            });')"
        # 送り元の IP（sourceIP）と受け取った側のアドレス（envelopeTo）は、公開の Issue・PR に貼らないので問い合わせない
        # shellcheck disable=SC2016 # node に渡す JavaScript で、$ はシェルの展開ではない
        ZONE="$zone" DAYS="${since:-7}" node -e '
            const end = new Date();
            const start = new Date(end - Number(process.env.DAYS) * 86_400_000);
            console.log(JSON.stringify({
                query: `query ($zoneTag: string!, $start: Date!, $end: Date!) {
                    viewer { zones(filter: { zoneTag: $zoneTag }) {
                        dmarcReportsSourcesAdaptiveGroups(limit: 1000, orderBy: [date_ASC, sum_totalMatchingMessages_DESC], filter: { date_geq: $start, date_leq: $end }) {
                            sum { totalMatchingMessages spfPass dkimPass dmarc }
                            dimensions { date sourceOrgName orgName disposition }
                        }
                    } }
                }`,
                variables: { zoneTag: process.env.ZONE, start: start.toISOString().slice(0, 10), end: end.toISOString().slice(0, 10) },
            }));' | post_json "$api/graphql" | fail_on_graphql_errors
        ;;
    web-analytics)
        # shellcheck disable=SC2016 # node に渡す JavaScript で、$ はシェルの展開ではない
        account_id="$(get_json "$api/accounts" | node -e '
            let body = "";
            process.stdin.on("data", (chunk) => (body += chunk)).on("end", () => {
                let accounts;
                try {
                    accounts = JSON.parse(body).result;
                } catch {
                    console.error(body);
                    process.exitCode = 1;
                    return;
                }
                // ほかのアカウントの訪問を混ぜないよう、1つでなければ止まる
                if (accounts?.length === 1) console.log(accounts[0].id);
                else {
                    console.error(`トークンが見るアカウントが1つでない（${accounts?.length}）`);
                    process.exitCode = 1;
                }
            });')"
        # site tag はビーコンの token と別物で、一覧を引くには Account Settings Read が要る。ホストで絞れば site tag を知らなくても取りこぼさない
        # クエリ文字列（UTM など）は RUM に無いので、どこから来たかは参照元のホストとパスで見る
        # shellcheck disable=SC2016 # node に渡す JavaScript で、$ はシェルの展開ではない
        ACCOUNT="$account_id" DAYS="${since:-7}" node -e '
            const end = new Date();
            const start = new Date(end - Number(process.env.DAYS) * 86_400_000);
            console.log(JSON.stringify({
                query: `query ($accountTag: string!, $start: Time!, $end: Time!) {
                    viewer { accounts(filter: { accountTag: $accountTag }) {
                        rumPageloadEventsAdaptiveGroups(limit: 5000, orderBy: [date_ASC, sum_visits_DESC], filter: { requestHost: "nu-tori.app", bot: 0, datetime_geq: $start, datetime_leq: $end }) {
                            count
                            sum { visits }
                            dimensions { date requestPath refererHost refererPath }
                        }
                    } }
                }`,
                variables: { accountTag: process.env.ACCOUNT, start: start.toISOString(), end: end.toISOString() },
            }));' | post_json "$api/graphql" | fail_on_graphql_errors | node -e '
            let body = "";
            process.stdin.on("data", (chunk) => (body += chunk)).on("end", () => {
                console.log(body);
                // 上限の行数で返ったときは、組み合わせが切れて数が欠けているかもしれないので、黙って通さない
                if (JSON.parse(body).data.viewer.accounts[0].rumPageloadEventsAdaptiveGroups.length >= 5000) {
                    console.error("5000 行で切れたかもしれない。日数を短くして読み直す");
                    process.exitCode = 1;
                }
            });'
        ;;
    # 先頭の確かめと一覧がずれたとき、何もせず 0 で抜けないようにする
    *) usage ;;
esac
