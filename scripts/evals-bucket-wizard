#!/usr/bin/env bash
# shellcheck disable=SC1087,SC2329 # ひな形のライブラリの分。$e[ は bash では配列の添え字にならず、使わない helper も残す（docs/agents/tooling.md の「ウィザード」）
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1 && tput clear 2>/dev/null; then return 0; fi
  printf '\033[2J\033[3J\033[H'
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else false; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any, with write_env's single
# quotes or a plain dotenv double-quoted value undone.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line value sq="'\\''"; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  value="${line#*=}"
  if [[ "$value" == \'*\' ]]; then value="${value:1:${#value}-2}"; value="${value//"$sq"/\'}"
  elif [[ "$value" == \"*\" ]]; then
    value="${value:1:${#value}-2}"
    [[ "$value" == *[\\\$\"]* ]] && return 1   # escapes, $ or ": can't decode safely; ask again
  fi
  printf '%s' "$value"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret), edited
# with Readline. Fails at EOF with no input.
ask() {
  local key="$1" prompt="$2" current input s=$'\001' e=$'\002' p rc=0
  current=$(_existing "$key" || true)
  # Readline needs the colour codes wrapped in \001..\002 to place the cursor.
  p="  $s$BOLD$e$prompt$s$RESET$e "
  [[ -n "$current" ]] && p+="$s$DIM$e[Enter keeps current]$s$RESET$e "
  read -e -r -p "$p" input || rc=1
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input rc=0
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || rc=1
  printf '\n'
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY='VALUE' into ENV_FILE (replaces any existing
# line) and sets $KEY. Idempotent. Creates ENV_FILE at mode 0600; writes through
# a symlink and keeps an existing file's mode.
write_env() {
  local key="$1" value="$2" tmp sq="'\\''"
  [[ -e "$ENV_FILE" ]] || (umask 077 && : > "$ENV_FILE")
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf "%s='%s'\n" "$key" "${value//\'/$sq}" >> "$tmp"
  cat "$tmp" > "$ENV_FILE"
  rm -f "$tmp"
  printf -v "$key" '%s' "$value"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# Keep every stage inside run_wizard and the last line as is: bash then parses
# the whole file before the first prompt, so an edit mid-run can't break it.
# ──────────────────────────────────────────────────────────────────────────


# 評価の写真の置き場（R2 のバケット nu-tori-evals）と、そのバケットだけを読める鍵を、開発者が作って置く（#519）。開発者が Mac で回す
# 鍵は Mac のシェルの設定と、クラウドの環境 nu-tori（Sentry のトークンと同じ置き場）にだけ置く。.env にも GitHub にも書かない
# 読み方と置き場の名前は docs/agents/tooling.md の「Cloudflare を読む」と、scripts/cloudflare の evals

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUCKET="nu-tori-evals"
# アプリの写真のバケット。鍵がこれを読めないことを確かめる（server/wrangler.jsonc）
APP_BUCKETS="nu-tori-production-photos nu-tori-development-photos"
R2_OVERVIEW="https://dash.cloudflare.com/?to=/:account/r2/overview"
# ask は .env を既定の値として読むので、読み書きしない先にする
ENV_FILE=/dev/null
CF_ACCOUNT_ID="${NU_TORI_CLOUDFLARE_ACCOUNT_ID:-}"
EVALS_KEY_ID=""
EVALS_SECRET=""
SHELL_RC=""

# ask_value [ask|ask_secret] VAR "問い" は、空でない値を受け取るまで聞き直す
ask_value() {
  local reader="$1" key="$2" prompt="$3"
  while true; do
    "$reader" "$key" "$prompt" || exit 1
    [[ -n "${!key}" ]] && return
    warn "空のままでは進めない"
  done
}

# r2_status BUCKET は、受け取った鍵でそのバケットの一覧を1件だけ求め、HTTP の状態コードだけを出す（本文は出さない）
r2_status() {
  curl --silent --output /dev/null --write-out '%{http_code}' --aws-sigv4 "aws:amz:auto:s3" \
    --user "${EVALS_KEY_ID}:${EVALS_SECRET}" \
    "https://${CF_ACCOUNT_ID}.r2.cloudflarestorage.com/${1}?list-type=2&max-keys=1" || true
}

# upsert_export FILE NAME VALUE は、シェルの設定の export NAME=... の行を置き換える（無ければ足す）。何度回しても1行になる
upsert_export() {
  local file="$1" name="$2" value="$3" tmp sq="'\\''"
  [[ -e "$file" ]] || : > "$file"
  tmp=$(mktemp)
  grep -vE "^export ${name}=" "$file" > "$tmp" || true
  printf "export %s='%s'\n" "$name" "${value//\'/$sq}" >> "$tmp"
  cat "$tmp" > "$file"
  rm -f "$tmp"
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$name" "$file"
}

run_wizard() {

TOTAL_STAGES=6

banner "nu-tori: 評価の写真の置き場（R2 の ${BUCKET}）と、読むだけの鍵"

if ! curl --help all 2>/dev/null | grep -q -- '--aws-sigv4'; then
  warn "この curl は --aws-sigv4 を持たない。macOS を上げるか、Homebrew の curl を PATH の先に置いてから回し直す"
  exit 1
fi

# ── 1 ───────────────────────────────────────────────────────────────────
stage "R2: バケット ${BUCKET} を作る"
say "評価の写真と正解の JSON を置く。アプリの写真のバケットとは分ける（アカウントや食事を消すと消え、名前が写真の ID でケースの名前を付けられないため）。"
say "済んでいれば Enter で次へ。"
open_url "$R2_OVERVIEW"
step "Create bucket → Bucket name: ${BUCKET}"
step "Location: Automatic、Default Storage Class: Standard のまま → Create bucket"
step "作ったバケットの Settings で、Public Development URL と Custom Domains が無効（公開していない）ことを見る"
note "画面の名前が違えば、同じ意味のものを選ぶ。公開の URL は付けない"
pause "作ったら Enter"

# ── 2 ───────────────────────────────────────────────────────────────────
stage "R2: ${BUCKET} だけを読む鍵（Object Read only）"
if [[ -n "${NU_TORI_CLOUDFLARE_EVALS_ACCESS_KEY_ID:-}" && -n "${NU_TORI_CLOUDFLARE_EVALS_SECRET_ACCESS_KEY:-}" ]] \
  && confirm "今のシェルにある NU_TORI_CLOUDFLARE_EVALS_* の鍵を使う？（作り直すなら N）"; then
  EVALS_KEY_ID="$NU_TORI_CLOUDFLARE_EVALS_ACCESS_KEY_ID"
  EVALS_SECRET="$NU_TORI_CLOUDFLARE_EVALS_SECRET_ACCESS_KEY"
else
  open_url "$R2_OVERVIEW"
  step "Account Details の API Tokens の Manage → Create Account API token"
  step "Token name: nu-tori-evals-read"
  step "Permissions: Object Read only"
  step "Specify bucket(s): Apply to specific buckets only → ${BUCKET} だけを選ぶ"
  step "TTL は Forever のまま、Client IP Address Filtering は空のまま → Create Account API token"
  note "User API token でなく Account API token にする（開発者のユーザーに結びつけない）"
  warn "Admin Read only は選ばない。すべてのバケット（アプリの写真）を読めてしまう"
  step "出た画面の Access Key ID と Secret Access Key を写す（Secret Access Key は二度と出ない）"
  ask_value ask EVALS_KEY_ID "Access Key ID:"
  ask_value ask_secret EVALS_SECRET "Secret Access Key:"
fi
if [[ -z "$CF_ACCOUNT_ID" ]]; then
  note "Account ID は R2 の Overview の Account Details にある"
  ask_value ask CF_ACCOUNT_ID "Account ID:"
fi

# ── 3 ───────────────────────────────────────────────────────────────────
stage "鍵を確かめる: ${BUCKET} を読め、アプリの写真のバケットを読めない"
say "${BUCKET} の一覧を読む（scripts/cloudflare evals list）"
if ! NU_TORI_CLOUDFLARE_ACCOUNT_ID="$CF_ACCOUNT_ID" NU_TORI_CLOUDFLARE_EVALS_ACCESS_KEY_ID="$EVALS_KEY_ID" \
  NU_TORI_CLOUDFLARE_EVALS_SECRET_ACCESS_KEY="$EVALS_SECRET" "${REPO_ROOT}/scripts/cloudflare" evals list >/dev/null; then
  warn "${BUCKET} を読めなかった（上の誤りを見る）。Account ID、鍵の写し間違い、2 の段の Specify bucket(s) を見て、回し直す"
  exit 1
fi
step "${BUCKET} を読めた"
for app_bucket in $APP_BUCKETS; do
  status="$(r2_status "$app_bucket")"
  if [[ "$status" == 2* ]]; then
    warn "${app_bucket} を読めてしまった（${status}）。この鍵の Permissions が広すぎる"
    note "R2 の API Tokens の Manage で nu-tori-evals-read を Revoke（戻せない）してから、2 の段からやり直す"
    exit 1
  fi
  step "${app_bucket} は読めない（${status}）"
done
pause "Enter で次へ"

# ── 4 ───────────────────────────────────────────────────────────────────
stage "Mac: シェルの設定に鍵を書く"
say "scripts/cloudflare evals を、この Mac のエージェントと人が呼べるようにする。"
case "${SHELL:-}" in
  */zsh) SHELL_RC="${HOME}/.zshrc" ;;
  *) SHELL_RC="${HOME}/.bash_profile" ;;
esac
note "NU_TORI_CLOUDFLARE_READ_TOKEN を別のファイルに書いているなら、そのファイルのパスを入れる"
read -e -r -p "  ${BOLD}書くファイル${RESET} ${DIM}[Enter で ${SHELL_RC}]${RESET} " rc_input || exit 1
[[ -z "$rc_input" ]] || SHELL_RC="${rc_input/#\~/$HOME}"
if confirm "${SHELL_RC} に NU_TORI_CLOUDFLARE_EVALS_ACCESS_KEY_ID と NU_TORI_CLOUDFLARE_EVALS_SECRET_ACCESS_KEY を書く？（同じ名前の行は置き換える）"; then
  upsert_export "$SHELL_RC" NU_TORI_CLOUDFLARE_EVALS_ACCESS_KEY_ID "$EVALS_KEY_ID"
  upsert_export "$SHELL_RC" NU_TORI_CLOUDFLARE_EVALS_SECRET_ACCESS_KEY "$EVALS_SECRET"
  if [[ -z "${NU_TORI_CLOUDFLARE_ACCOUNT_ID:-}" ]]; then
    upsert_export "$SHELL_RC" NU_TORI_CLOUDFLARE_ACCOUNT_ID "$CF_ACCOUNT_ID"
  fi
  note "開いている端末は、新しく開き直すか source ${SHELL_RC} で読み直す"
else
  SKIPPED+=("Mac のシェルの設定に NU_TORI_CLOUDFLARE_EVALS_ACCESS_KEY_ID と NU_TORI_CLOUDFLARE_EVALS_SECRET_ACCESS_KEY を書く")
fi
pause "Enter で次へ"

# ── 5 ───────────────────────────────────────────────────────────────────
stage "クラウドの環境 nu-tori に2つの値を貼る"
say "Sentry のトークン（NU_TORI_SENTRY_READ_TOKEN）と同じ環境に置く。NU_TORI_CLOUDFLARE_ACCOUNT_ID はもうある。"
step "claude.ai/code のセッションのタイトルバーの環境の名前 → nu-tori の Edit を開く"
step "Environment variables の欄の末尾に、次の2行を足す（.env の形で、1行に 名前=値）"
note "  NU_TORI_CLOUDFLARE_EVALS_ACCESS_KEY_ID・NU_TORI_CLOUDFLARE_EVALS_SECRET_ACCESS_KEY"
note "ネットは足さなくてよい（<Account ID>.r2.cloudflarestorage.com に、クラウドのセッションから届くことを 2026-11-09 に確かめた）"
block="NU_TORI_CLOUDFLARE_EVALS_ACCESS_KEY_ID=${EVALS_KEY_ID}
NU_TORI_CLOUDFLARE_EVALS_SECRET_ACCESS_KEY=${EVALS_SECRET}"
if command -v pbcopy >/dev/null 2>&1; then
  printf '%s\n' "$block" | pbcopy
  step "2行をクリップボードに写した。欄の末尾に貼って保存する（⌘V）"
  pause "保存したら Enter（クリップボードを空にする）"
  printf '' | pbcopy
else
  warn "pbcopy が無いので、次の2行を写して貼る（秘密の値が画面に出る）"
  pause "出してよければ Enter"
  printf '%s\n' "$block"
  pause "保存したら Enter"
  _clear
fi
block=""
note "Cursor の Cloud Agents でも読むなら、同じ2行を Secrets に置き、NU_TORI_CLOUDFLARE_EVALS_SECRET_ACCESS_KEY を Runtime Secret にする"
pause "Enter で次へ"

# ── 6 ───────────────────────────────────────────────────────────────────
stage "ケースの写真と正解の JSON の上げ方"
say "評価（server/evals/nutrition-label/）の実装と一緒に、写真が手に入った分から上げる。今は上げなくてよい。"
step "キーの形: nutrition-label/<番号>-<名前>/photo-1.jpg（2枚目は photo-2.jpg）と、隣に expected.json"
note "  例: nutrition-label/01-ramen-with-label/photo-1.jpg、nutrition-label/01-ramen-with-label/expected.json"
note "  キーは英数字と ._-/ だけ（scripts/cloudflare evals が受け付ける形）。expected.json の中身の形は評価の実装で決める"
step "上げ方: R2 の ${BUCKET} → Objects → Upload で、フォルダごと落とす（書く権限は開発者のログインで、上の鍵には無い）"
note "  または server/ で pnpm exec wrangler r2 object put ${BUCKET}/<キー> --file <ファイル> --remote（wrangler のログインで書く）"
warn "写真と JSON は公開リポジトリに入れない。写っているのは開発者が撮った市販品だけにし、本番の写真の控えは使わない"
SKIPPED+=("クラウドの環境 nu-tori の新しいセッションで「scripts/cloudflare evals list を回して、${BUCKET} を読めるか確かめて」と頼む")
pause "Enter で終わる"

finish
}

run_wizard "$@"; exit
