#!/usr/bin/env bash
# エージェントと人が Sentry の課題・イベント・スタックを読む `sentry` CLI（課題を解決するのは scripts/production-alerts だけ）。版と設定を、ここ1か所に置く
set -euo pipefail

# 読んだ課題の中身が CLI 自身の失敗の報告に乗って送られないよう、報告を止める。版は下で固定するので、更新の確認も止める
export SENTRY_CLI_NO_TELEMETRY=1
export SENTRY_CLI_NO_UPDATE_CHECK=1
export SENTRY_ORG="${SENTRY_ORG:-nu-tori-fv}"

# 解決のトークンは、scripts/production-alerts が Sentry の課題を解決する呼び出しにだけ渡す。エージェントの環境には置かない
if [ -n "${NU_TORI_SENTRY_RESOLVE_TOKEN:-}" ]; then
    export SENTRY_AUTH_TOKEN="$NU_TORI_SENTRY_RESOLVE_TOKEN"
    export SENTRY_FORCE_ENV_TOKEN=1
# 読むだけのトークンは、dSYM を上げる組織のトークン（Xcode Cloud の SENTRY_AUTH_TOKEN）と混ざらない名前で受け取る
elif [ -n "${NU_TORI_SENTRY_READ_TOKEN:-}" ]; then
    export SENTRY_AUTH_TOKEN="$NU_TORI_SENTRY_READ_TOKEN"
    # 保存したログインがあると環境変数より先に使われるので、環境変数を先にする
    export SENTRY_FORCE_ENV_TOKEN=1
else
    # シェルに残った dSYM 用の組織のトークンを使わず、保存した読むだけのログインを使う
    unset SENTRY_AUTH_TOKEN SENTRY_TOKEN
fi

args=("$@")
# issue events の期間の既定は 7 日で、それより前に起きた課題は空で返る。issue list の既定（90 日）にそろえる
if [ "${1:-}" = issue ] && [ "${2:-}" = events ]; then
    period_given=false
    for arg in "$@"; do
        case "$arg" in
            -t | -t?* | --period | --period=*) period_given=true ;;
        esac
    done
    if [ "$period_given" = false ]; then
        args+=(--period 90d)
    fi
fi

exec npx -y sentry@0.46.0 ${args[@]+"${args[@]}"}
